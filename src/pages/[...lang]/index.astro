---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import GalleryMarquee from '../../components/GalleryMarquee.astro';
import JoinBand from '../../components/JoinBand.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations } from '../../i18n';
import { getEvents, splitEvents, getPage, getMemoriesByYear } from '../../lib/content';
import grup from '../../assets/hram-grup.jpg';
import stema from '../../assets/stema-mitropolia-color.png';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const { upcoming } = splitEvents(await getEvents(lang));

const { Content: Despre } = await getPage('despre', lang);

// Prima fotografie a fiecărei amintiri, cele mai noi primele: alimentează atât
// banda rulantă, cât și mozaicul de la finalul paginii.
const carouselImages = (await getMemoriesByYear(lang))
  .flatMap(({ entries }) => entries)
  .filter(({ memory }) => memory.data.images.length > 0)
  .map(({ memory, slug }) => ({
    src: memory.data.images[0]!.src,
    alt: memory.data.images[0]!.alt,
    href: localePath(lang, `/amintiri/${slug}/`),
    caption: memory.data.title,
  }));
---

<Base lang={lang} title={t('site.name')} description={t('site.description')}>
  <!--
    Hero: o afirmație tipografică lată, iar dedesubt fotografia de grup pe toată
    lățimea. Pozele frăției sunt făcute cu telefonul și niciuna nu e „eroică"
    singură — dar o fotografie de grup mare spune tot ce trebuie dintr-o privire.
  -->
  <section class="bg-white">
    <div class="mx-auto max-w-6xl px-4 pt-12 pb-10 sm:pt-20 sm:pb-14">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brand-600 sm:text-sm">
        {t('home.eyebrow')}
      </p>
      <h1
        class="mt-5 max-w-4xl font-serif text-[2.1rem] font-bold leading-[1.08] tracking-tight text-brand-950 sm:text-5xl lg:text-6xl"
      >
        {t('home.heroHeadline')}
      </h1>
      <div class="mt-7 flex flex-col gap-6 sm:mt-9 sm:flex-row sm:items-end sm:justify-between">
        <p class="max-w-xl text-base leading-relaxed text-stone-600 sm:text-lg">{t('home.heroLead')}</p>
        <a
          href={localePath(lang, '/evenimente/')}
          class="shrink-0 self-start rounded-full bg-brand-800 px-7 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 sm:self-auto"
        >
          {t('home.allActivities')} →
        </a>
      </div>
    </div>

    <Image
      src={grup}
      alt={t('home.heroPhotoAlt')}
      widths={[640, 960, 1400, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-[62vw] max-h-[34rem] min-h-[17rem] w-full object-cover"
    />
  </section>

  <!-- Apartenența la Mitropolie -->
  <section class="border-b border-stone-200 bg-brand-50" aria-labelledby="moreom-titlu">
    <div
      class="mx-auto flex max-w-4xl flex-col items-center gap-6 px-4 py-12 text-center sm:flex-row sm:gap-10 sm:text-left"
    >
      <Image
        src={stema}
        alt={t('home.moreomAlt')}
        width="288"
        height="311"
        format="webp"
        loading="lazy"
        class="h-32 w-auto shrink-0 sm:h-40"
      />
      <h2 id="moreom-titlu" class="font-serif text-xl font-bold leading-snug text-brand-950 sm:text-2xl">
        {t('home.moreomTitle')}
      </h2>
    </div>
  </section>

  <!--
    Următorul eveniment, ca rând de calendar: data ancorează privirea în stânga,
    conținutul curge în dreapta. Aliniat la stânga, nu centrat — se citește mai repede.
  -->
  <section class="mx-auto max-w-4xl px-4 py-14 sm:py-20" aria-labelledby="eveniment-evidentiat">
    <h2
      id="eveniment-evidentiat"
      class="mb-8 text-xs font-semibold uppercase tracking-[0.18em] text-brand-600 sm:text-sm"
    >
      {t('home.nextEvent')}
    </h2>
    {upcoming[0] && <EventRow event={upcoming[0]} lang={lang} detailed headingLevel="h3" />}
    {
      upcoming.length === 0 && (
        <p class="max-w-prose border-t border-stone-300 pt-6 text-stone-600">{t('home.noUpcoming')}</p>
      )
    }
    <p class="mt-10">
      <a
        href={localePath(lang, '/evenimente/')}
        class="text-sm font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 transition-colors hover:text-brand-900"
      >
        {t('home.allActivities')} →
      </a>
    </p>
  </section>

  <!-- Bandă rulantă cu momente din toate evenimentele -->
  <section class="border-t border-stone-200 bg-white py-14 sm:py-20" aria-labelledby="galerie-titlu">
    <h2
      id="galerie-titlu"
      class="mb-8 px-4 text-center text-xs font-semibold uppercase tracking-[0.18em] text-brand-600 sm:text-sm"
    >
      {t('home.galleryTitle')}
    </h2>
    <GalleryMarquee images={carouselImages} lang={lang} />
    <p class="mt-10 text-center">
      <a
        href={localePath(lang, '/amintiri/')}
        class="text-sm font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 transition-colors hover:text-brand-900"
      >
        {t('home.seeMemories')} →
      </a>
    </p>
  </section>

  <!-- Despre -->
  <section class="border-t border-stone-200" aria-labelledby="despre-titlu">
    <div class="mx-auto max-w-3xl px-4 py-14 sm:py-20">
      <h2 id="despre-titlu" class="font-serif text-2xl font-bold text-brand-950 sm:text-3xl">
        {t('home.about.title')}
      </h2>
      <div class="prose-md mt-6 text-stone-700">
        <Despre />
      </div>
    </div>
  </section>

  <!-- Invitația, cu mozaic de chipuri -->
  <JoinBand lang={lang} images={carouselImages} />
</Base>

---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import EventLead from '../../components/EventLead.astro';
import ArchiveRow from '../../components/ArchiveRow.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, formatDate } from '../../i18n';
import { getEvents, splitEvents, getPage, getMemoriesByYear } from '../../lib/content';
import grup from '../../assets/hram-grup.jpg';
import stema from '../../assets/stema-mitropolia.png';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const { upcoming } = splitEvents(await getEvents(lang));
const { Content: Despre } = await getPage('despre', lang);

// Cele mai recente patru amintiri, oricare ar fi anul lor.
const recente = (await getMemoriesByYear(lang)).flatMap(({ entries }) => entries).slice(0, 4);
---

<Base lang={lang} title={t('site.name')} description={t('site.description')}>
  <!--
    Hero: titlul stă PESTE fotografie, cu un voal întunecat dedesubt care îi
    asigură contrastul. Fotografiile frăției sunt făcute în interioare slab
    luminate; voalul le unifică și scoate literele deasupra oricărei încadrări.
  -->
  <section class="relative">
    <Image
      src={grup}
      alt={t('home.heroPhotoAlt')}
      widths={[640, 960, 1400, 1920]}
      sizes="100vw"
      format="webp"
      quality={72}
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="h-[78vh] max-h-[38rem] min-h-[26rem] w-full object-cover"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/35 to-black/5"
      aria-hidden="true"
    >
    </div>

    <div class="absolute inset-x-0 bottom-0">
      <div class="mx-auto max-w-6xl px-4 pb-8 sm:pb-12">
        <p class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.18em] text-white/75">
          {t('home.eyebrow')}
        </p>
        <h1
          class="mt-3 max-w-3xl font-serif text-[2.25rem] font-bold leading-[1.05] text-white sm:text-6xl"
        >
          {t('home.heroHeadline')}
        </h1>
        <p class="mt-4 max-w-xl text-[0.9375rem] leading-relaxed text-white/85 sm:text-lg">
          {t('home.heroLead')}
        </p>
      </div>
    </div>
  </section>

  <!-- Apartenența la Mitropolie, spusă o dată, discret -->
  <section class="border-b border-rule bg-paper-deep" aria-labelledby="moreom-titlu">
    <div class="mx-auto flex max-w-3xl items-center gap-4 px-4 py-5 sm:gap-6">
      <Image
        src={stema}
        alt=""
        width="120"
        height="130"
        format="webp"
        loading="lazy"
        class="h-11 w-auto shrink-0 opacity-80 sm:h-14"
      />
      <p id="moreom-titlu" class="font-serif text-[0.9375rem] leading-snug text-muted sm:text-base">
        {t('home.moreomTitle')}
      </p>
    </div>
  </section>

  <!-- Urmează -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:py-20" aria-labelledby="urmeaza">
    <SectionTitle id="urmeaza">{t('home.sectionUpcoming')}</SectionTitle>
    <div class="mt-10">
      {upcoming[0] && <EventLead event={upcoming[0]} lang={lang} headingLevel="h3" />}
      {
        upcoming.length === 0 && (
          <p class="mx-auto max-w-[62ch] text-center text-[0.9375rem] leading-relaxed text-muted">
            {t('home.noUpcoming')}
          </p>
        )
      }
    </div>
    <p class="mt-10">
      <a
        href={localePath(lang, '/evenimente/')}
        class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
      >
        {t('archive.allEvents')}
      </a>
    </p>
  </section>

  <!-- Din arhivă -->
  <section class="border-t border-rule bg-paper-deep" aria-labelledby="arhiva">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <SectionTitle id="arhiva" bg="paper-deep">{t('home.sectionArchive')}</SectionTitle>
      <div class="mt-6 divide-y divide-rule">
        {
          recente.map(({ memory, slug }) => (
            <ArchiveRow
              title={memory.data.title}
              href={localePath(lang, `/amintiri/${slug}/`)}
              eyebrow={t('archive.eyebrowMemory')}
              meta={
                memory.data.date && memory.data.showDate
                  ? formatDate(memory.data.date, lang)
                  : String(memory.data.year)
              }
              image={memory.data.images[0]?.src}
              imageAlt={memory.data.images[0]?.alt}
            />
          ))
        }
      </div>
      <p class="mt-8">
        <a
          href={localePath(lang, '/amintiri/')}
          class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          {t('archive.allMemories')}
        </a>
      </p>
    </div>
  </section>

  <!-- Despre -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:py-20" aria-labelledby="despre">
    <SectionTitle id="despre">{t('home.sectionAbout')}</SectionTitle>
    <div class="prose-j mx-auto mt-10 max-w-[62ch] text-ink">
      <Despre />
    </div>
  </section>

  <!-- Invitația: un bloc liniștit, nu o bandă colorată -->
  <section class="border-t border-rule bg-paper-deep" aria-labelledby="vino">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <SectionTitle id="vino" bg="paper-deep">{t('home.sectionJoin')}</SectionTitle>
      <p class="mx-auto mt-10 max-w-[54ch] text-center font-serif text-lg leading-relaxed text-ink sm:text-xl">
        {t('home.joinText')}
      </p>
      <p class="mt-8 text-center">
        <a
          href={localePath(lang, '/devino-membru/')}
          class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          {t('home.joinCta')}
        </a>
      </p>
    </div>
  </section>
</Base>

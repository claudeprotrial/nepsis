---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arc from '../../components/Arc.astro';
import Rubrica from '../../components/Rubrica.astro';
import EventRow from '../../components/EventRow.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, withBase } from '../../i18n';
import { getEvents, splitEvents, getPage, getMemoriesByYear } from '../../lib/content';
import { dimensiuni } from '../../lib/imagini';
import cruce from '../../assets/cruce-tus.png';
import stema from '../../assets/stema-mitropolia-color.png';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const { upcoming } = splitEvents(await getEvents(lang));
const urmator = upcoming[0];
const { Content: Despre } = await getPage('despre', lang);

// Amintirile care au fotografii, cele mai noi primele.
const cuPoze = (await getMemoriesByYear(lang))
  .flatMap(({ entries }) => entries)
  .filter(({ memory }) => memory.data.images.length > 0);

// Fereastra ia singură prima fotografie a celei mai noi amintiri, deci se schimbă
// pe măsură ce frăția trăiește: în august e un munte în soare, nu o criptă.
const fereastra = cuPoze[0]?.memory.data.images[0];

// „Lumina de afară”: următoarele șase amintiri, fiecare cu fotografia ei întreagă.
const momente = await Promise.all(
  cuPoze.slice(1, 7).map(async ({ memory, slug }) => {
    const img = memory.data.images[0]!;
    const d = await dimensiuni(img.src);
    return { src: img.src, alt: img.alt, w: d?.w, h: d?.h, titlu: memory.data.title, href: localePath(lang, `/amintiri/${slug}/`) };
  }),
);
---

<Base lang={lang} title={t('site.name')} description={t('site.description')}>
  <!--
    Fereastra. Totul e deja la locul lui din primul cadru — nimic nu urcă și nimic
    nu apare. Singurul lucru care se mișcă e lumina care intră în arc.
    Pe telefon arcul trece primul: primul ecran trebuie să arate chipuri de oameni.
  -->
  <section class="bg-lumina">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 pt-6 pb-16 md:grid-cols-2 md:gap-16 md:py-20">
      {
        fereastra && (
          <Arc
            src={fereastra.src}
            alt={fereastra.alt}
            lumina
            eager
            sizes="(min-width: 768px) 46vw, 100vw"
            class="md:order-last"
          />
        )
      }
      <div>
        <Image src={cruce} alt="" width={62} height={80} format="webp" class="h-10 w-auto" />
        <p class="mt-7 font-serif text-[1.375rem] text-umbra italic">{t('home.eyebrow')}</p>
        <h1 class="titlu-mare mt-1">{t('site.name')}</h1>
        <Rubrica lang={lang} class="mt-5" />
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-3">
          <a href={localePath(lang, '/evenimente/')} class="secundar">{t('home.nextEvent')}</a>
          <a href={localePath(lang, '/devino-membru/')} class="candela">{t('nav.join')}</a>
          <a href={localePath(lang, '/contact/')} class="secundar">{t('nav.contact')}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Următorul eveniment: singura suprafață „de seară” din site. -->
  <section class="bg-seara" aria-labelledby="urmatorul">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-20">
      <h2 id="urmatorul" class="titlu">{t('home.nextEvent')}</h2>
      {
        urmator ? (
          <div class="mt-10">
            <EventRow event={urmator} lang={lang} detailed headingLevel="h3" />
          </div>
        ) : (
          <p class="mt-6 max-w-[62ch] text-umbra">{t('home.noUpcoming')}</p>
        )
      }
      <p class="mt-8">
        <a href={localePath(lang, '/evenimente/')} class="secundar">{t('home.allActivities')}</a>
      </p>
    </div>
  </section>

  <!--
    Lumina de afară. Fotografiile nu se taie: pozele de grup sunt late pentru că
    grupurile sunt late. Pe telefon stau una sub alta, pe toată lățimea, ca să se
    vadă chipurile; mai sus curg în coloane, fiecare la proporțiile ei.
  -->
  {
    momente.length > 0 && (
      <section class="bg-lumina" aria-labelledby="momente">
        <div class="mx-auto max-w-7xl px-4 py-16 md:py-20">
          <h2 id="momente" class="titlu">{t('home.carouselTitle')}</h2>
          <div class="mt-10 gap-8 sm:columns-2 lg:columns-3">
            {momente.map((m) => (
              <article class="mb-10 break-inside-avoid">
                <a href={m.href} class="group block">
                  <img
                    src={withBase(m.src)}
                    alt={m.alt}
                    width={m.w}
                    height={m.h}
                    loading="lazy"
                    decoding="async"
                    class="block h-auto w-full"
                  />
                  <span class="mt-3 block font-serif text-lg leading-snug text-cerneala underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-cerneala">
                    {m.titlu}
                  </span>
                </a>
              </article>
            ))}
          </div>
          <p>
            <a href={localePath(lang, '/amintiri/')} class="secundar">{t('home.seeMemories')}</a>
          </p>
        </div>
      </section>
    )
  }

  <!-- Cine suntem. Intervalul de vârstă stă separat, deasupra textului: e ce caută cine se întreabă dacă i se adresează. -->
  <section class="border-t border-linie bg-lumina" aria-labelledby="despre">
    <div class="mx-auto max-w-7xl px-4 py-16 md:py-20">
      <h2 id="despre" class="titlu">{t('home.about.title')}</h2>
      <p class="mt-5 max-w-[46ch] font-serif text-[1.375rem] leading-snug italic">{t('home.ageRange')}</p>
      <div class="proza mt-8">
        <Despre />
      </div>
      <p class="mt-8 max-w-[62ch] text-umbra">
        {t('home.moreAbout')}
        <a
          href={localePath(lang, '/amintiri/')}
          class="text-cerneala underline decoration-candela underline-offset-[6px] hover:decoration-2"
        >
          {t('home.moreAboutLink')}
        </a>
      </p>
    </div>
  </section>

  <!-- Sub omoforul Mitropoliei. Stema se arată în culorile ei: e însemn pictat, nu decor. -->
  <section class="bg-zi" aria-labelledby="moreom">
    <div class="mx-auto flex max-w-7xl flex-col items-start gap-6 px-4 py-10 sm:flex-row sm:items-center">
      <Image
        src={stema}
        alt={t('home.moreomAlt')}
        width={144}
        height={156}
        format="webp"
        loading="lazy"
        class="h-[4.5rem] w-auto shrink-0"
      />
      <h2 id="moreom" class="max-w-[46ch] font-serif text-[1.375rem] leading-snug">{t('home.moreomTitle')}</h2>
    </div>
  </section>
</Base>

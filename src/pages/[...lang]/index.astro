---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Emblema from '../../components/Emblema.astro';
import Foto from '../../components/Foto.astro';
import MemoryCard from '../../components/MemoryCard.astro';
import { render } from 'astro:content';
import { langStaticPaths, localeFromParam, localePath, useTranslations, formatDate } from '../../i18n';
import { getEvents, splitEvents, getPage, getMemoriesByYear } from '../../lib/content';
import stema from '../../assets/stema-mitropolia-color.png';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const { upcoming } = splitEvents(await getEvents(lang));
const next = upcoming[0];
const NextContent = next ? (await render(next)).Content : null;

const { Content: Despre } = await getPage('despre', lang);

const amintiri = (await getMemoriesByYear(lang)).flatMap(({ entries }) => entries);
const recente = amintiri.slice(0, 3);
const mozaic = amintiri.filter(({ memory }) => memory.data.images.length > 0).slice(0, 8);

const butonAlb =
  'inline-block bg-white px-7 py-3.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-swiss transition-colors hover:bg-white/90';
const butonConturAlb =
  'inline-block border border-white/60 px-7 py-3.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-white transition-colors hover:border-white hover:bg-white/10';
const butonRosu =
  'inline-block bg-swiss px-7 py-3.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-white transition-colors hover:bg-swiss-deep';
---

<Base lang={lang} title={t('site.name')} description={t('site.description')}>
  <!--
    Hero: câmp roșu plin, cu sigla uriașă ton pe ton. Fotografia de dedesubt e
    tratată în același roșu, deci nu există hotar între text și imagine —
    e o singură suprafață, ca steagul.
  -->
  <section class="relative overflow-hidden bg-swiss text-white">
    <Emblema
      class="pointer-events-none absolute -top-16 -right-20 h-[22rem] w-[22rem] text-swiss-deep sm:h-[32rem] sm:w-[32rem] lg:-right-10 lg:h-[40rem] lg:w-[40rem]"
    />

    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:py-24 lg:py-28">
      <p class="eyebrow text-white/75">{t('home.eyebrow')}</p>
      <h1
        class="mt-5 max-w-[18ch] font-serif text-[2.5rem] font-bold leading-[1.03] sm:text-6xl lg:text-7xl"
      >
        {t('home.heroHeadline')}
      </h1>
      <p class="mt-6 max-w-[52ch] text-base leading-relaxed text-white/85 sm:text-lg">
        {t('home.heroLead')}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href={localePath(lang, '/devino-membru/')} class={butonAlb}>{t('home.joinCta')}</a>
        <a href={localePath(lang, '/evenimente/')} class={butonConturAlb}>{t('archive.allEvents')}</a>
      </div>
    </div>

    <Foto
      src="/img/2022_hram.JPG"
      alt={t('home.heroPhotoAlt')}
      eager
      class="h-[46vw] max-h-[30rem] min-h-[15rem]"
    />
  </section>

  <!--
    Apartenența la Mitropolie. Stema se arată în culorile ei: e însemn oficial,
    nu ilustrație, și tocmai contrastul cu pozele roșii o scoate în evidență.
  -->
  <section class="border-b border-rule" aria-labelledby="moreom">
    <div class="mx-auto flex max-w-4xl items-center gap-5 px-4 py-6 sm:gap-7">
      <Image
        src={stema}
        alt=""
        width="120"
        height="130"
        format="webp"
        loading="lazy"
        class="h-14 w-auto shrink-0 sm:h-16"
      />
      <p id="moreom" class="font-serif text-[0.9375rem] leading-snug text-muted sm:text-base">
        {t('home.moreomTitle')}
      </p>
    </div>
  </section>

  <!-- Ce urmează -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20" aria-labelledby="urmeaza">
    <h2 id="urmeaza" class="eyebrow text-swiss">{t('home.sectionUpcoming')}</h2>
    {
      next && NextContent ? (
        <div class="mt-6 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
          <div>
            <p class="font-sans text-sm font-semibold tracking-[0.06em] text-muted">
              <time datetime={next.data.date.toISOString().slice(0, 10)}>
                {formatDate(next.data.date, lang)}
              </time>
              {next.data.location && <span class="mx-2 text-rule">·</span>}
              {next.data.location}
            </p>
            <h3 class="mt-2 font-serif text-3xl font-bold leading-tight text-ink sm:text-4xl">
              {next.data.title}
            </h3>
            <div class="prose-n mt-5 max-w-[58ch] text-ink">
              <NextContent />
            </div>
            <p class="mt-8">
              <a href={localePath(lang, '/evenimente/')} class={butonRosu}>
                {t('archive.allEvents')}
              </a>
            </p>
          </div>
          {next.data.image && (
            <Foto
              src={next.data.image}
              alt={next.data.imageAlt ?? ''}
              class="aspect-[4/3] lg:aspect-auto lg:h-full"
            />
          )}
        </div>
      ) : (
        <p class="mt-6 max-w-[58ch] text-[1.0625rem] leading-relaxed text-muted">
          {t('home.noUpcoming')}
        </p>
      )
    }
  </section>

  <!-- Din amintirile noastre: câmp roșu, fotografii în același roșu -->
  <section class="bg-swiss py-16 text-white sm:py-20" aria-labelledby="amintiri">
    <div class="mx-auto max-w-7xl px-4">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 id="amintiri" class="font-serif text-3xl font-bold sm:text-4xl">
          {t('home.sectionArchive')}
        </h2>
        <a
          href={localePath(lang, '/amintiri/')}
          class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-white underline decoration-white/40 underline-offset-4 hover:decoration-white"
        >
          {t('archive.allMemories')}
        </a>
      </div>

      <div class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {
          recente.map(({ memory, slug }) => (
            <MemoryCard
              memory={memory}
              lang={lang}
              href={localePath(lang, `/amintiri/${slug}/`)}
              peRosu
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cine suntem -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20" aria-labelledby="despre">
    <h2 id="despre" class="eyebrow text-swiss">{t('home.sectionAbout')}</h2>
    <div class="prose-n mt-6 max-w-[62ch] text-ink">
      <Despre />
    </div>
  </section>

  <!-- E loc și pentru tine -->
  <section class="relative overflow-hidden bg-swiss-deep text-white" aria-labelledby="vino">
    <Emblema
      class="pointer-events-none absolute -bottom-24 -left-16 h-80 w-80 text-white/[0.07] sm:h-[26rem] sm:w-[26rem]"
    />
    <div class="relative mx-auto max-w-7xl px-4 py-16 sm:py-20">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <h2 id="vino" class="font-serif text-3xl font-bold leading-tight sm:text-5xl">
            {t('home.sectionJoin')}
          </h2>
          <p class="mt-5 max-w-[46ch] text-base leading-relaxed text-white/85 sm:text-lg">
            {t('home.joinText')}
          </p>
          <p class="mt-8">
            <a href={localePath(lang, '/devino-membru/')} class={butonAlb}>{t('home.joinCta')}</a>
          </p>
        </div>

        <!-- Mozaic de instantanee, toate în același roșu -->
        <div class="grid grid-cols-4 gap-2">
          {
            mozaic.map(({ memory }, i) => (
              <Foto
                src={memory.data.images[0]!.src}
                class:list={['aspect-square', i >= 4 && 'hidden sm:block']}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>

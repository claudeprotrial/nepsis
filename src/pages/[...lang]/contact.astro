---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ObfuscatedEmail from '../../components/ObfuscatedEmail.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const link = 'text-swiss underline decoration-swiss/40 underline-offset-4 hover:decoration-swiss';
const buton =
  'inline-block bg-swiss px-7 py-3.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-white transition-colors hover:bg-swiss-deep';

const utile = [
  { href: 'http://www.nepsis.org/', label: t('contact.useful.nepsis') },
  { href: 'http://www.mitropolia.eu/ro/', label: t('contact.useful.mitropolia') },
  { href: 'http://www.mitropolia.eu/ro/site/172/', label: t('contact.useful.parohii') },
  { href: 'http://monasteresuisse.mitropolia.eu/', label: t('contact.useful.manastire') },
];
---

<Base lang={lang} title={`${t('contact.title')} · ${t('site.name')}`} description={t('contact.description')}>
  <PageHero title={t('contact.title')} intro={t('contact.intro')} />

  <div class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      <div class="space-y-12">
        <section aria-labelledby="contact-email">
          <h2 id="contact-email" class="eyebrow text-swiss">{t('contact.writeUs')}</h2>
          <p class="mt-3 text-[1.0625rem] leading-relaxed text-muted">{t('contact.emailIntro')}</p>
          <p class="mt-3 font-serif text-2xl">
            <ObfuscatedEmail class="text-ink underline decoration-swiss/40 underline-offset-4 hover:decoration-swiss" />
          </p>
          <p class="mt-6">
            <!-- Legătura asamblează adresa la click — nu există „mailto:” în clar în HTML. -->
            <a
              href="#"
              class:list={['email-protejat-buton', buton]}
              data-x="nepsis.ch"
              data-y="mitropolia"
              data-z="eu"
            >
              {t('contact.emailButton')}
            </a>
          </p>
        </section>

        <section class="border-t border-rule pt-12" aria-labelledby="contact-grupuri">
          <h2 id="contact-grupuri" class="eyebrow text-swiss">{t('contact.groups')}</h2>
          <p class="mt-3 max-w-[52ch] text-[1.0625rem] leading-relaxed text-muted">
            {t('contact.groupsText')}
          </p>
          <p class="mt-4">
            <a href={localePath(lang, '/newsletter/')} class={link}>{t('contact.newsletterLink')}</a>
          </p>
          <h3 class="eyebrow mt-8 text-swiss">{t('contact.social')}</h3>
          <SocialLinks class="mt-3 -ml-2 gap-1 [&_a]:text-muted [&_a:hover]:text-swiss" />
        </section>
      </div>

      <div class="space-y-12">
        <section aria-labelledby="contact-banca">
          <h2 id="contact-banca" class="eyebrow text-swiss">{t('contact.bank')}</h2>
          <dl class="mt-4 divide-y divide-rule border-t border-rule text-[0.9375rem]">
            <div class="flex gap-4 py-3">
              <dt class="w-28 shrink-0 font-sans text-xs tracking-[0.06em] text-muted">IBAN</dt>
              <dd class="font-serif text-lg">CH95 0900 0000 1545 2680 8</dd>
            </div>
            <div class="flex gap-4 py-3">
              <dt class="w-28 shrink-0 font-sans text-xs tracking-[0.06em] text-muted">BIC</dt>
              <dd class="font-serif text-lg">POFICHBEXXX</dd>
            </div>
            <div class="flex gap-4 py-3">
              <dt class="w-28 shrink-0 font-sans text-xs tracking-[0.06em] text-muted">
                {t('contact.bank.holder')}
              </dt>
              <dd class="font-serif text-lg">Nepsis Elvetia</dd>
            </div>
          </dl>
        </section>

        <section class="border-t border-rule pt-12" aria-labelledby="contact-utile">
          <h2 id="contact-utile" class="eyebrow text-swiss">{t('contact.useful')}</h2>
          <ul class="mt-4 space-y-3 text-[0.9375rem] leading-relaxed">
            {
              utile.map((u) => (
                <li>
                  <a href={u.href} target="_blank" rel="noopener" class={link}>
                    {u.label}
                  </a>
                </li>
              ))
            }
            <li class="text-muted">
              {t('contact.useful.pelerinaje')}
              <ObfuscatedEmail x="pelerin" class={link} />
            </li>
          </ul>
        </section>
      </div>
    </div>
  </div>

  <!-- Invitația închide pagina, pe roșu -->
  <section class="bg-swiss text-white" aria-labelledby="contact-membru">
    <div class="mx-auto max-w-7xl px-4 py-14 text-center sm:py-16">
      <h2 id="contact-membru" class="font-serif text-2xl font-bold sm:text-4xl">{t('contact.joinTitle')}</h2>
      <p class="mx-auto mt-4 max-w-[52ch] text-base leading-relaxed text-white/85">
        {t('contact.joinText')}
      </p>
      <p class="mt-8">
        <a
          href={localePath(lang, '/devino-membru/')}
          class="inline-block bg-white px-7 py-3.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-swiss transition-colors hover:bg-white/90"
        >
          {t('contact.joinLink')}
        </a>
      </p>
    </div>
  </section>
</Base>

<script>
  // Același mecanism anti-spam și pentru butonul mare de e-mail.
  document.querySelectorAll<HTMLAnchorElement>('.email-protejat-buton').forEach((el) => {
    el.addEventListener('click', (ev) => {
      ev.preventDefault();
      const { x, y, z } = el.dataset;
      window.location.href = `mailto:${x}@${y}.${z}`;
    });
  });
</script>

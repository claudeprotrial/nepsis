---
import Base from '../../layouts/Base.astro';
import ObfuscatedEmail from '../../components/ObfuscatedEmail.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const legatura = 'text-cerneala underline decoration-candela underline-offset-[6px] hover:decoration-2';
const utile = [
  { href: 'http://www.mitropolia.eu/ro/', label: t('contact.useful.mitropolia') },
  { href: 'http://www.nepsis.org/', label: t('contact.useful.nepsis') },
  { href: 'http://www.mitropolia.eu/ro/site/172/', label: t('contact.useful.parohii') },
  { href: 'http://monasteresuisse.mitropolia.eu/', label: t('contact.useful.manastire') },
];
---

<Base lang={lang} title={`${t('contact.title')} · ${t('site.name')}`} description={t('contact.description')}>
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <!--
      Titlul paginii și fraza de întâmpinare au fost scoase la cererea
      utilizatorului. „Scrie-ne” urcă în locul lor ca h1: pagina trebuie să
      păstreze un titlu de nivel întâi pentru cititoarele de ecran și pentru
      indexare, iar numele rubricii rămâne în <title>.
    -->
    <div class="grid gap-14 md:grid-cols-2">
      <section aria-labelledby="contact-email">
        <h1 id="contact-email" class="titlu-mare">{t('contact.writeUs')}</h1>
        <p class="mt-6 text-umbra">{t('contact.emailIntro')}</p>
        <p class="mt-2 font-serif text-[1.375rem]">
          <ObfuscatedEmail class="text-cerneala underline decoration-linie underline-offset-[6px] hover:decoration-cerneala" />
        </p>
        <p class="mt-8">
          <!-- Butonul asamblează adresa la click — nu există „mailto:” în clar în HTML. -->
          <a href="#" class="email-protejat-buton candela" data-x="nepsis.ch" data-y="mitropolia" data-z="eu">
            {t('contact.emailButton')}
          </a>
        </p>
      </section>

      <section class="border-t border-linie pt-10 md:border-t-0 md:pt-0" aria-labelledby="contact-grupuri">
        <h2 id="contact-grupuri" class="titlu">{t('contact.groups')}</h2>
        <p class="mt-5 max-w-[62ch]">{t('contact.groupsText')}</p>
        <p class="mt-4">
          <a href={localePath(lang, '/newsletter/')} class="secundar">{t('contact.newsletterLink')}</a>
        </p>
        <h3 class="mt-8 font-sans text-sm font-medium">{t('contact.social')}</h3>
        <SocialLinks class="mt-2 -ml-2.5 gap-0.5" />
      </section>
    </div>

    <section class="mt-20 bg-zi px-6 py-10 md:flex md:items-center md:justify-between md:gap-10 md:px-10" aria-labelledby="contact-membru">
      <div>
        <h2 id="contact-membru" class="titlu-mic">{t('contact.joinTitle')}</h2>
        <p class="mt-2 max-w-[52ch] text-umbra">{t('contact.joinText')}</p>
      </div>
      <p class="mt-6 shrink-0 md:mt-0">
        <a href={localePath(lang, '/devino-membru/')} class="candela">{t('contact.joinLink')}</a>
      </p>
    </section>

    <div class="mt-20 grid gap-14 md:grid-cols-2">
      <section aria-labelledby="contact-banca">
        <h2 id="contact-banca" class="titlu-mic">{t('contact.bank')}</h2>
        <dl class="mt-6 divide-y divide-linie border-y border-linie text-[0.9375rem]">
          <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-3">
            <dt class="text-umbra">IBAN</dt>
            <dd class="tabular-nums">CH95 0900 0000 1545 2680 8</dd>
          </div>
          <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-3">
            <dt class="text-umbra">BIC</dt>
            <dd>POFICHBEXXX</dd>
          </div>
          <div class="grid grid-cols-[7rem_minmax(0,1fr)] gap-4 py-3">
            <dt class="text-umbra">{t('contact.bank.holder')}</dt>
            <dd>Nepsis Elvetia</dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="contact-utile">
        <h2 id="contact-utile" class="titlu-mic">{t('contact.useful')}</h2>
        <ul class="mt-6 space-y-3">
          {
            utile.map((u) => (
              <li>
                <a href={u.href} target="_blank" rel="noopener" class={legatura}>
                  {u.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Base>

<script>
  // Același mecanism anti-spam și pentru butonul mare de e-mail.
  document.querySelectorAll<HTMLAnchorElement>('.email-protejat-buton').forEach((el) => {
    el.addEventListener('click', (ev) => {
      ev.preventDefault();
      const { x, y, z } = el.dataset;
      window.location.href = `mailto:${x}@${y}.${z}`;
    });
  });
</script>

---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ObfuscatedEmail from '../../components/ObfuscatedEmail.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const linkClass =
  'text-ink underline decoration-rule underline-offset-4 transition-colors hover:decoration-accent';
const accentLink =
  'font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent';

const utile = [
  { href: 'http://www.nepsis.org/', label: t('contact.useful.nepsis') },
  { href: 'http://www.mitropolia.eu/ro/', label: t('contact.useful.mitropolia') },
  { href: 'http://www.mitropolia.eu/ro/site/172/', label: t('contact.useful.parohii') },
  { href: 'http://monasteresuisse.mitropolia.eu/', label: t('contact.useful.manastire') },
];
---

<Base lang={lang} title={`${t('contact.title')} · ${t('site.name')}`} description={t('contact.description')}>
  <PageHeader title={t('contact.title')} intro={t('contact.intro')} />

  <!--
    Fără casete: rubricile se despart prin linii, ca într-un colofon. Coloana din
    stânga ține căile de legătură, cea din dreapta informațiile de serviciu.
  -->
  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      <div class="space-y-12">
        <section aria-labelledby="contact-email">
          <h2 id="contact-email" class="eyebrow">{t('contact.writeUs')}</h2>
          <p class="mt-3 text-[1.0625rem] leading-relaxed text-muted">{t('contact.emailIntro')}</p>
          <p class="mt-3 font-serif text-xl">
            <ObfuscatedEmail class={linkClass} />
          </p>
          <p class="mt-5">
            <!-- Legătura asamblează adresa la click — nu există „mailto:” în clar în HTML. -->
            <a
              href="#"
              class:list={['email-protejat-buton', accentLink]}
              data-x="nepsis.ch"
              data-y="mitropolia"
              data-z="eu"
            >
              {t('contact.emailButton')} →
            </a>
          </p>
        </section>

        <section class="border-t border-rule pt-12" aria-labelledby="contact-grupuri">
          <h2 id="contact-grupuri" class="eyebrow">{t('contact.groups')}</h2>
          <p class="mt-3 max-w-[52ch] text-[1.0625rem] leading-relaxed text-muted">
            {t('contact.groupsText')}
          </p>
          <p class="mt-4">
            <a href={localePath(lang, '/newsletter/')} class={linkClass}>{t('contact.newsletterLink')}</a>
          </p>
          <h3 class="eyebrow mt-8">{t('contact.social')}</h3>
          <SocialLinks class="mt-3 -ml-2 gap-1 [&_a]:text-muted [&_a:hover]:text-accent" />
        </section>
      </div>

      <div class="space-y-12">
        <section aria-labelledby="contact-banca">
          <h2 id="contact-banca" class="eyebrow">{t('contact.bank')}</h2>
          <dl class="mt-4 divide-y divide-rule border-t border-rule text-[0.9375rem]">
            <div class="flex gap-4 py-2.5">
              <dt class="meta w-28 shrink-0 pt-0.5">IBAN</dt>
              <dd class="font-serif">CH95 0900 0000 1545 2680 8</dd>
            </div>
            <div class="flex gap-4 py-2.5">
              <dt class="meta w-28 shrink-0 pt-0.5">BIC</dt>
              <dd class="font-serif">POFICHBEXXX</dd>
            </div>
            <div class="flex gap-4 py-2.5">
              <dt class="meta w-28 shrink-0 pt-0.5">{t('contact.bank.holder')}</dt>
              <dd class="font-serif">Nepsis Elvetia</dd>
            </div>
          </dl>
        </section>

        <section class="border-t border-rule pt-12" aria-labelledby="contact-utile">
          <h2 id="contact-utile" class="eyebrow">{t('contact.useful')}</h2>
          <ul class="mt-4 space-y-3 text-[0.9375rem] leading-relaxed">
            {
              utile.map((u) => (
                <li>
                  <a href={u.href} target="_blank" rel="noopener" class={linkClass}>
                    {u.label}
                  </a>
                </li>
              ))
            }
            <li class="text-muted">
              {t('contact.useful.pelerinaje')}
              <ObfuscatedEmail x="pelerin" class={linkClass} />
            </li>
          </ul>
        </section>
      </div>
    </div>

    <!-- Invitația, ca notă de subsol a paginii -->
    <section class="mt-16 border-t border-rule pt-10 text-center" aria-labelledby="contact-membru">
      <h2 id="contact-membru" class="font-serif text-2xl font-bold text-ink sm:text-3xl">
        {t('contact.joinTitle')}
      </h2>
      <p class="mx-auto mt-3 max-w-[52ch] text-[1.0625rem] leading-relaxed text-muted">
        {t('contact.joinText')}
      </p>
      <p class="mt-6">
        <a href={localePath(lang, '/devino-membru/')} class={accentLink}>{t('contact.joinLink')} →</a>
      </p>
    </section>
  </div>
</Base>

<script>
  // Același mecanism anti-spam și pentru legătura mare de e-mail.
  document.querySelectorAll<HTMLAnchorElement>('.email-protejat-buton').forEach((el) => {
    el.addEventListener('click', (ev) => {
      ev.preventDefault();
      const { x, y, z } = el.dataset;
      window.location.href = `mailto:${x}@${y}.${z}`;
    });
  });
</script>

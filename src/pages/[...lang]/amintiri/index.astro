---
import Base from '../../../layouts/Base.astro';
import MemoryTile from '../../../components/MemoryTile.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, defaultLocale } from '../../../i18n';
import { getMemoriesByYear } from '../../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Grupate automat pe ani, cei mai noi primii.
const years = await getMemoriesByYear(lang);
---

<Base lang={lang} title={`${t('memories.title')} · ${t('site.name')}`} description={t('memories.description')}>
  <div class="mx-auto max-w-5xl px-4 py-10 sm:py-14">
    <h1 class="font-serif text-3xl font-bold text-brand-950 sm:text-4xl">{t('memories.title')}</h1>
    <p class="mt-3 max-w-prose text-lg text-stone-600">{t('memories.intro')}</p>
    {lang !== defaultLocale && <p class="mt-2 text-sm italic text-stone-500">{t('memories.onlyRo')}</p>}

    <!-- Cuprins pe ani -->
    <nav aria-label={t('memories.year')} class="mt-6 flex flex-wrap gap-2">
      {
        years.map(({ year }) => (
          <a
            href={`#an${year}`}
            class="rounded-full border border-brand-200 bg-white px-4 py-1.5 text-sm font-semibold text-brand-800 transition-colors hover:bg-brand-50"
          >
            {year}
          </a>
        ))
      }
    </nav>

    <!--
      Galerie pe ani: fiecare amintire e o fotografie cu titlu, nu un articol
      întreg. Textul se citește pe pagina proprie a amintirii — aici contează
      să vezi dintr-o privire ce s-a întâmplat în fiecare an.
    -->
    <div class="mt-12 space-y-14">
      {
        years.map(({ year, entries }) => (
          <section aria-labelledby={`an${year}`}>
            <h2
              id={`an${year}`}
              class="scroll-mt-24 border-b border-stone-300 pb-3 font-serif text-2xl font-bold text-brand-900 sm:text-3xl"
            >
              {t('memories.year')} {year}
            </h2>
            <div class="mt-8 grid grid-cols-2 gap-x-5 gap-y-9 lg:grid-cols-3 lg:gap-x-7">
              {entries.map(({ memory, slug }) => (
                <MemoryTile memory={memory} lang={lang} href={localePath(lang, `/amintiri/${slug}/`)} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>

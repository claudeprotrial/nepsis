---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import MemoryCard from '../../../components/MemoryCard.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, defaultLocale } from '../../../i18n';
import { getMemoriesByYear } from '../../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Grupate automat pe ani, cei mai noi primii.
const years = await getMemoriesByYear(lang);
---

<Base lang={lang} title={`${t('memories.title')} · ${t('site.name')}`} description={t('memories.description')}>
  <PageHero title={t('memories.title')} intro={t('memories.intro')}>
    {lang !== defaultLocale && <p class="mt-4 text-sm italic text-white/70">{t('memories.onlyRo')}</p>}

    <!-- Cuprins pe ani -->
    <nav aria-label={t('memories.year')} class="mt-8 flex flex-wrap gap-2">
      {
        years.map(({ year }) => (
          <a
            href={`#an${year}`}
            class="border border-white/40 px-3.5 py-1.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-white transition-colors hover:bg-white hover:text-swiss"
          >
            {year}
          </a>
        ))
      }
    </nav>
  </PageHero>

  <div class="mx-auto max-w-7xl px-4 pb-20">
    {
      years.map(({ year, entries }) => (
        <section class="pt-14 sm:pt-16" aria-labelledby={`an${year}`}>
          <h2
            id={`an${year}`}
            class="scroll-mt-6 border-b border-rule pb-3 font-serif text-2xl font-bold text-ink sm:text-3xl"
          >
            {year}
          </h2>
          <div class="mt-8 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {entries.map(({ memory, slug }) => (
              <MemoryCard memory={memory} lang={lang} href={localePath(lang, `/amintiri/${slug}/`)} />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

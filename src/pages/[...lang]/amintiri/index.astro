---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {
  langStaticPaths,
  localeFromParam,
  localePath,
  useTranslations,
  defaultLocale,
  formatDate,
  withBase,
} from '../../../i18n';
import { getMemoriesByYear } from '../../../lib/content';
import { dimensiuni } from '../../../lib/imagini';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Grupate automat pe ani, cei mai noi primii. Textul întreg al fiecărei amintiri
// rămâne pe index, ca în v8; fotografia de copertă stă la proporțiile ei, netăiată.
const ani = await Promise.all(
  (await getMemoriesByYear(lang)).map(async ({ year, entries }) => ({
    year,
    intrari: await Promise.all(
      entries.map(async ({ memory, slug }) => {
        const coperta = memory.data.images[0];
        return {
          memory,
          href: localePath(lang, `/amintiri/${slug}/`),
          Content: (await render(memory)).Content,
          coperta,
          dim: coperta ? await dimensiuni(coperta.src) : null,
        };
      }),
    ),
  })),
);
---

<Base lang={lang} title={`${t('memories.title')} · ${t('site.name')}`} description={t('memories.description')}>
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <h1 class="titlu-mare">{t('memories.title')}</h1>
    <p class="mt-4 max-w-[62ch] text-umbra">{t('memories.intro')}</p>
    {lang !== defaultLocale && <p class="mt-2 text-sm text-umbra italic">{t('memories.onlyRo')}</p>}

    <nav aria-label={t('memories.year')} class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {
        ani.map(({ year }) => (
          <a
            href={`#an${year}`}
            class="text-cerneala tabular-nums underline decoration-linie underline-offset-[6px] transition-colors hover:decoration-cerneala"
          >
            {year}
          </a>
        ))
      }
    </nav>

    <div class="mt-14">
      {
        ani.map(({ year, intrari }) => (
          <section
            class="border-t border-cerneala py-12 md:grid md:grid-cols-[9rem_minmax(0,1fr)] md:gap-10"
            aria-labelledby={`an${year}`}
          >
            {/* Anul rămâne lipit în margine cât derulezi amintirile lui. */}
            <h2
              id={`an${year}`}
              class="scroll-mt-24 font-serif text-[2.75rem] leading-none font-light tabular-nums md:sticky md:top-24 md:self-start"
            >
              {year}
            </h2>
            <div class="mt-8 divide-y divide-linie md:mt-0">
              {intrari.map(({ memory, href, Content, coperta, dim }) => (
                <article
                  class:list={[
                    'py-10 first:pt-0 last:pb-0',
                    coperta && 'lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-10',
                  ]}
                >
                  {coperta && (
                    <a href={href} class="block self-start">
                      <img
                        src={withBase(coperta.src)}
                        alt={coperta.alt}
                        width={dim?.w}
                        height={dim?.h}
                        loading="lazy"
                        decoding="async"
                        class="block h-auto w-full"
                      />
                    </a>
                  )}
                  <div class:list={[coperta && 'mt-6 lg:mt-0']}>
                    <h3 class="titlu-mic">
                      <a
                        href={href}
                        class="underline decoration-transparent underline-offset-[6px] transition-colors hover:decoration-cerneala"
                      >
                        {memory.data.title}
                      </a>
                    </h3>
                    {memory.data.date && memory.data.showDate && (
                      <p class="mt-1.5 text-sm text-umbra">
                        <time datetime={memory.data.date.toISOString().slice(0, 10)}>
                          {formatDate(memory.data.date, lang)}
                        </time>
                      </p>
                    )}
                    <div class="proza mt-5">
                      <Content />
                    </div>
                    <p class="mt-4">
                      <a href={href} class="secundar">{t('memories.readMore')}</a>
                    </p>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>

---
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import SectionTitle from '../../../components/SectionTitle.astro';
import ArchiveRow from '../../../components/ArchiveRow.astro';
import {
  langStaticPaths,
  localeFromParam,
  localePath,
  useTranslations,
  formatDate,
  defaultLocale,
} from '../../../i18n';
import { getMemoriesByYear } from '../../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Grupate automat pe ani, cei mai noi primii.
const years = await getMemoriesByYear(lang);
---

<Base lang={lang} title={`${t('memories.title')} · ${t('site.name')}`} description={t('memories.description')}>
  <PageHeader title={t('memories.title')} intro={t('memories.intro')}>
    {lang !== defaultLocale && <p class="meta mt-4 italic">{t('memories.onlyRo')}</p>}

    <!-- Cuprins pe ani: coduri scurte, despărțite de bare, ca un index de revistă. -->
    <nav aria-label={t('memories.year')} class="mt-7 flex flex-wrap items-center gap-x-1 gap-y-2">
      {
        years.map(({ year }, i) => (
          <>
            {i > 0 && <span class="text-rule" aria-hidden="true">/</span>}
            <a
              href={`#an${year}`}
              class="px-1.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-muted transition-colors hover:text-accent"
            >
              {year}
            </a>
          </>
        ))
      }
    </nav>
  </PageHeader>

  <div class="mx-auto max-w-6xl px-4 pb-16 sm:pb-24">
    {
      years.map(({ year, entries }) => (
        <section class="pt-14 sm:pt-20" aria-labelledby={`an${year}`}>
          <div class="scroll-mt-8" id={`an${year}`}>
            <SectionTitle>{`${t('memories.year')} ${year}`}</SectionTitle>
          </div>
          <div class="mt-6 divide-y divide-rule border-t border-rule">
            {entries.map(({ memory, slug }) => (
              <ArchiveRow
                title={memory.data.title}
                href={localePath(lang, `/amintiri/${slug}/`)}
                eyebrow={t('archive.eyebrowMemory')}
                meta={
                  memory.data.date && memory.data.showDate
                    ? formatDate(memory.data.date, lang)
                    : String(memory.data.year)
                }
                image={memory.data.images[0]?.src}
                imageAlt={memory.data.images[0]?.alt}
              />
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

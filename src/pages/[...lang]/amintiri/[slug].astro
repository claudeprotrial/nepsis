---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Foto from '../../../components/Foto.astro';
import {
  locales,
  defaultLocale,
  localeFromParam,
  localePath,
  useTranslations,
  formatDate,
} from '../../../i18n';
import { groupByTranslationKey, canonicalOf, localizedOf } from '../../../lib/content';

// O pagină per amintire, în fiecare limbă (cu fallback pe română pentru text).
// Slug-ul este numele fișierului variantei românești — identic în toate limbile.
export async function getStaticPaths() {
  const all = await getCollection('amintiri');
  const paths = [];
  for (const group of groupByTranslationKey(all).values()) {
    const slug = canonicalOf(group).id;
    for (const l of locales) {
      paths.push({
        params: { lang: l === defaultLocale ? undefined : l, slug },
        props: { memory: localizedOf(group, l) },
      });
    }
  }
  return paths;
}

interface Props {
  memory: CollectionEntry<'amintiri'>;
}

const { memory } = Astro.props;
const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { Content } = await render(memory);
const images = memory.data.images;

const data =
  memory.data.date && memory.data.showDate ? formatDate(memory.data.date, lang) : String(memory.data.year);

// Meta description: primul rând de text, fără marcaje Markdown/HTML.
const description =
  memory.body
    ?.replace(/<[^>]+>/g, ' ')
    .replace(/[#*_>\[\]]|\([^)]*\)/g, ' ')
    .split('\n')
    .map((l) => l.trim())
    .find((l) => l.length > 40)
    ?.slice(0, 160) ?? t('memories.description');
---

<Base
  lang={lang}
  title={`${memory.data.title} · ${t('site.name')}`}
  description={description}
  ogImage={images[0]?.src}
>
  <PageHero title={memory.data.title} eyebrow={data} />

  <article class="mx-auto max-w-[68ch] px-4 py-12 sm:py-16">
    <nav class="mb-8">
      <a
        href={localePath(lang, `/amintiri/#an${memory.data.year}`)}
        class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-swiss underline decoration-swiss/40 underline-offset-4 hover:decoration-swiss"
      >
        ← {t('memories.back')}
      </a>
    </nav>

    <div class="prose-n text-ink">
      <Content />
    </div>

    <!--
      Aici fotografiile se arată în culorile lor, nu tratate în roșu: pe suprafețele
      de brand (prima pagină, arhivă) roșul unifică instantaneele inegale, dar pe
      pagina amintirii fotografia E subiectul și trebuie văzută cum a fost.
    -->
    {
      images.length > 0 && (
        <div class="mt-12 grid gap-4 sm:grid-cols-2">
          {images.map((img, i) => (
            <Foto
              src={img.src}
              alt={img.alt}
              natural
              eager={i === 0}
              class:list={['aspect-[4/3]', images.length % 2 === 1 && i === 0 && 'sm:col-span-2 sm:aspect-[16/9]']}
            />
          ))}
        </div>
      )
    }
  </article>
</Base>

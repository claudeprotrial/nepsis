---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Arc from '../../../components/Arc.astro';
import {
  locales,
  defaultLocale,
  localeFromParam,
  localePath,
  useTranslations,
  formatDate,
  withBase,
} from '../../../i18n';
import { groupByTranslationKey, canonicalOf, localizedOf } from '../../../lib/content';
import { dimensiuni } from '../../../lib/imagini';

// O pagină per amintire, în fiecare limbă (cu fallback pe română pentru text).
// Slug-ul este numele fișierului variantei românești — identic în toate limbile.
export async function getStaticPaths() {
  const all = await getCollection('amintiri');
  const paths = [];
  for (const group of groupByTranslationKey(all).values()) {
    const slug = canonicalOf(group).id;
    for (const l of locales) {
      paths.push({
        params: { lang: l === defaultLocale ? undefined : l, slug },
        props: { memory: localizedOf(group, l) },
      });
    }
  }
  return paths;
}

interface Props {
  memory: CollectionEntry<'amintiri'>;
}

const { memory } = Astro.props;
const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { Content } = await render(memory);
const images = memory.data.images;
const coperta = images[0];
// Restul fotografiilor, la proporțiile lor reale: pe pagina amintirii fotografia e subiectul.
const restul = await Promise.all(images.slice(1).map(async (img) => ({ ...img, dim: await dimensiuni(img.src) })));

// Meta description: primul rând de text, fără marcaje Markdown/HTML.
const description =
  memory.body
    ?.replace(/<[^>]+>/g, ' ')
    .replace(/[#*_>\[\]]|\([^)]*\)/g, ' ')
    .split('\n')
    .map((l) => l.trim())
    .find((l) => l.length > 40)
    ?.slice(0, 160) ?? t('memories.description');
---

<Base lang={lang} title={`${memory.data.title} · ${t('site.name')}`} description={description} ogImage={coperta?.src}>
  <article class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <p>
      <a href={localePath(lang, `/amintiri/#an${memory.data.year}`)} class="secundar">{t('memories.back')}</a>
    </p>

    <header class="mt-8 max-w-[44rem]">
      <p class="font-serif text-[1.375rem] text-umbra italic">{t('memories.year')} {memory.data.year}</p>
      <h1 class="titlu-mare mt-1">{memory.data.title}</h1>
      {
        memory.data.date && memory.data.showDate && (
          <p class="mt-3 text-sm text-umbra">
            <time datetime={memory.data.date.toISOString().slice(0, 10)}>{formatDate(memory.data.date, lang)}</time>
          </p>
        )
      }
    </header>

    {coperta && <Arc src={coperta.src} alt={coperta.alt} eager sizes="(min-width: 1024px) 64rem, 100vw" class="mt-10 max-w-5xl" />}

    <div class="proza mt-12">
      <Content />
    </div>

    {
      restul.length > 0 && (
        <div class="mt-14 gap-8 md:columns-2">
          {restul.map((img) => (
            <img
              src={withBase(img.src)}
              alt={img.alt}
              width={img.dim?.w}
              height={img.dim?.h}
              loading="lazy"
              decoding="async"
              class="mb-8 block h-auto w-full break-inside-avoid"
            />
          ))}
        </div>
      )
    }
  </article>
</Base>

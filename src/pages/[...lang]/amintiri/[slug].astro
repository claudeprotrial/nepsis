---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import {
  locales,
  defaultLocale,
  localeFromParam,
  localePath,
  useTranslations,
  formatDate,
  withBase,
} from '../../../i18n';
import { groupByTranslationKey, canonicalOf, localizedOf } from '../../../lib/content';

// O pagină per amintire, în fiecare limbă (cu fallback pe română pentru text).
// Slug-ul este numele fișierului variantei românești — identic în toate limbile.
export async function getStaticPaths() {
  const all = await getCollection('amintiri');
  const paths = [];
  for (const group of groupByTranslationKey(all).values()) {
    const slug = canonicalOf(group).id;
    for (const l of locales) {
      paths.push({
        params: { lang: l === defaultLocale ? undefined : l, slug },
        props: { memory: localizedOf(group, l) },
      });
    }
  }
  return paths;
}

interface Props {
  memory: CollectionEntry<'amintiri'>;
}

const { memory } = Astro.props;
const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { Content } = await render(memory);
const images = memory.data.images;
const [lead, ...rest] = images;

// Meta description: primul rând de text, fără marcaje Markdown/HTML.
const description =
  memory.body
    ?.replace(/<[^>]+>/g, ' ')
    .replace(/[#*_>\[\]]|\([^)]*\)/g, ' ')
    .split('\n')
    .map((l) => l.trim())
    .find((l) => l.length > 40)
    ?.slice(0, 160) ?? t('memories.description');
---

<Base
  lang={lang}
  title={`${memory.data.title} · ${t('site.name')}`}
  description={description}
  ogImage={images[0]?.src}
>
  <article>
    <!-- Antetul articolului, pe coloană îngustă -->
    <header class="border-b border-rule">
      <div class="mx-auto max-w-[68ch] px-4 py-10 sm:py-14">
        <nav>
          <a
            href={localePath(lang, `/amintiri/#an${memory.data.year}`)}
            class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-muted transition-colors hover:text-accent"
          >
            ← {t('memories.back')}
          </a>
        </nav>

        <p class="eyebrow mt-7">
          {t('archive.eyebrowMemory')}
          <span class="mx-2 text-rule" aria-hidden="true">·</span>
          {memory.data.year}
        </p>

        <h1 class="mt-2 font-serif text-[2rem] font-bold leading-tight text-ink sm:text-[2.75rem]">
          {memory.data.title}
        </h1>

        {
          memory.data.date && memory.data.showDate && (
            <p class="meta mt-3">
              <time datetime={memory.data.date.toISOString().slice(0, 10)}>
                {formatDate(memory.data.date, lang)}
              </time>
            </p>
          )
        }
      </div>
    </header>

    <!-- Fotografia de deschidere, lată cât coloana de text -->
    {
      lead && (
        <figure class="mx-auto max-w-[68ch] px-4 pt-10">
          <img
            src={withBase(lead.src)}
            alt={lead.alt}
            loading="eager"
            decoding="async"
            class="w-full rounded-sm object-cover"
          />
        </figure>
      )
    }

    <div class="prose-j mx-auto mt-10 max-w-[62ch] px-4 text-ink">
      <Content />
    </div>

    <!-- Restul fotografiilor, ca planșe -->
    {
      rest.length > 0 && (
        <div class="mx-auto mt-14 max-w-[68ch] px-4 pb-16 sm:pb-20">
          <div class="grid gap-4 sm:grid-cols-2">
            {rest.map((img) => (
              <img
                src={withBase(img.src)}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full rounded-sm object-cover"
              />
            ))}
          </div>
        </div>
      )
    }
    {rest.length === 0 && <div class="pb-16 sm:pb-20"></div>}
  </article>
</Base>

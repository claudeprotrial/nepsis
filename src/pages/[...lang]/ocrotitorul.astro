---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Arc from '../../components/Arc.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';
import icoana from '../../assets/iconita-sf-Casian-fata.jpg';
import hram from '../../assets/hram-grup.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('ocrotitorul', lang);
---

<Base
  lang={lang}
  title={`${t('patron.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('patron.description')}
  ogImage="/img/iconita-sf-Casian-fata.jpg"
>
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <header class="max-w-[44rem]">
      <h1 class="titlu-mare">{t('patron.title')}</h1>
      <p class="mt-3 font-serif text-[1.375rem] text-umbra italic">{t('patron.subtitle')}</p>
    </header>

    <div class="mt-12 gap-14 md:grid md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <!--
        Icoana nu se decupează niciodată: are numele sfântului inscripționat în
        colțurile de sus. Stă dreptunghiulară, la proporțiile ei, și rămâne în vedere
        cât se citește textul.
      -->
      <figure class="md:sticky md:top-24 md:self-start">
        <Image
          src={icoana}
          alt={t('patron.iconAlt')}
          widths={[360, 720, 1000]}
          sizes="(min-width: 768px) 38vw, 100vw"
          format="webp"
          quality={78}
          fetchpriority="high"
          decoding="async"
          class="block h-auto w-full border border-linie bg-lumina p-2"
        />
      </figure>
      <div class="proza mt-10 md:mt-0">
        <Content />
      </div>
    </div>

    <!-- Arcul paginii: tinerii frăției la hramul ocrotitorului lor. -->
    <Arc imagine={hram} alt={t('patron.hramAlt')} sizes="(min-width: 1280px) 80rem, 100vw" class="mt-20" />
  </div>
</Base>

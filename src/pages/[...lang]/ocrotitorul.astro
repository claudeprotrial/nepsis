---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';
import icoana from '../../assets/iconita-sf-Casian-fata.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('ocrotitorul', lang);
---

<Base
  lang={lang}
  title={`${t('patron.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('patron.description')}
  ogImage="/img/iconita-sf-Casian-fata.jpg"
>
  <PageHeader title={t('patron.title')} eyebrow={t('patron.subtitle')} />

  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
    <div class="gap-12 md:grid md:grid-cols-[18rem_1fr] lg:gap-16">
      <!-- Icoana rămâne vizibilă cât timp se citește textul, pe ecran mare. -->
      <figure class="mx-auto max-w-[18rem] md:sticky md:top-8 md:self-start">
        <Image
          src={icoana}
          alt={t('patron.iconAlt')}
          widths={[320, 640]}
          sizes="18rem"
          format="webp"
          quality={74}
          fetchpriority="high"
          decoding="async"
          class="w-full rounded-sm"
        />
      </figure>
      <div class="prose-j mt-10 max-w-[62ch] text-ink md:mt-0">
        <Content />
      </div>
    </div>
  </div>
</Base>

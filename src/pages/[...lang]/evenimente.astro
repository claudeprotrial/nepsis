---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import EventLead from '../../components/EventLead.astro';
import ArchiveRow from '../../components/ArchiveRow.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, formatDate } from '../../i18n';
import { getEvents, splitEvents, getOptionalPage } from '../../lib/content';
import psalticaLogo from '../../assets/nepsis_psaltica_logo.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Împărțirea se face automat la fiecare build, după data evenimentului.
const { upcoming, past } = splitEvents(await getEvents(lang));

// Calendarul anual, editabil ca simplu fișier Markdown (opțional).
const calendar = await getOptionalPage('calendar', lang);
const CalendarContent = calendar?.Content;

const eventMeta = (e: (typeof past)[number]) =>
  [formatDate(e.data.date, lang), e.data.location].filter(Boolean).join(' · ');
---

<Base lang={lang} title={`${t('activities.title')} · ${t('site.name')}`} description={t('activities.description')}>
  <PageHeader title={t('activities.title')} intro={t('activities.intro')} />

  <!-- Urmează -->
  <section class="mx-auto max-w-6xl px-4 py-14 sm:py-20" aria-labelledby="urmeaza">
    <SectionTitle id="urmeaza">{t('home.sectionUpcoming')}</SectionTitle>
    {
      upcoming.length === 0 ? (
        <p class="mx-auto mt-10 max-w-[62ch] text-center text-[0.9375rem] leading-relaxed text-muted">
          {t('activities.noUpcoming')}
        </p>
      ) : (
        <>
          <div class="mt-10">
            <EventLead event={upcoming[0]!} lang={lang} headingLevel="h3" />
          </div>
          {upcoming.length > 1 && (
            <div class="mt-12 divide-y divide-rule border-t border-rule">
              {upcoming.slice(1).map((event) => (
                <ArchiveRow
                  title={event.data.title}
                  href={`#eveniment-${event.data.translationKey}`}
                  eyebrow={t('archive.eyebrowEvent')}
                  meta={eventMeta(event)}
                  image={event.data.image}
                  imageAlt={event.data.imageAlt ?? ''}
                />
              ))}
            </div>
          )}
        </>
      )
    }
  </section>

  <!-- Calendarul anual (editabil din src/content/pagini/ro/calendar.md) -->
  {
    calendar && CalendarContent && (
      <section class="border-t border-rule bg-paper-deep" aria-labelledby="calendar-anual">
        <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
          <SectionTitle id="calendar-anual" bg="paper-deep">
            {calendar.entry.data.title}
          </SectionTitle>
          <div class="prose-j mx-auto mt-10 max-w-[70ch] text-ink">
            <CalendarContent />
          </div>
        </div>
      </section>
    )
  }

  <!-- Activitate permanentă -->
  <section class="border-t border-rule" aria-labelledby="permanent">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-4 py-14 sm:py-20 md:grid-cols-[1fr_1.4fr] md:gap-12">
      <Image
        src={psalticaLogo}
        alt={t('psaltica.logoAlt')}
        widths={[400, 700]}
        sizes="(min-width: 768px) 33vw, 90vw"
        format="webp"
        quality={72}
        loading="lazy"
        decoding="async"
        class="w-full rounded-sm object-cover"
      />
      <div>
        <p class="eyebrow">{t('psaltica.title')}</p>
        <h2 id="permanent" class="mt-2 font-serif text-2xl font-bold leading-snug text-ink sm:text-3xl">
          {t('activities.permanent')}
        </h2>
        <p class="mt-4 max-w-[58ch] text-[1.0625rem] leading-relaxed text-muted">
          {t('activities.permanentText')}
        </p>
        <p class="mt-6">
          <a
            href={localePath(lang, '/psaltica/')}
            class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
          >
            {t('activities.permanentLink')}
          </a>
        </p>
      </div>
    </div>
  </section>

  <!-- Evenimente recente -->
  <section class="border-t border-rule bg-paper-deep" aria-labelledby="recente">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <SectionTitle id="recente" bg="paper-deep">{t('activities.past')}</SectionTitle>
      <div class="mt-6 divide-y divide-rule">
        {
          past.slice(0, 4).map((event) => (
            <ArchiveRow
              title={event.data.title}
              href={localePath(lang, '/amintiri/')}
              eyebrow={t('archive.eyebrowEvent')}
              meta={eventMeta(event)}
              image={event.data.image}
              imageAlt={event.data.imageAlt ?? ''}
            />
          ))
        }
      </div>
      <p class="mt-8">
        <a
          href={localePath(lang, '/amintiri/')}
          class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          {t('archive.allMemories')}
        </a>
      </p>
    </div>
  </section>
</Base>

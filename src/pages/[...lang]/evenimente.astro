---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Foto from '../../components/Foto.astro';
import EventCard from '../../components/EventCard.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, formatDate } from '../../i18n';
import { getEvents, splitEvents, getOptionalPage } from '../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Împărțirea se face automat la fiecare build, după data evenimentului.
const { upcoming, past } = splitEvents(await getEvents(lang));
const next = upcoming[0];
const NextContent = next ? (await render(next)).Content : null;

// Calendarul anual, editabil ca simplu fișier Markdown (opțional).
const calendar = await getOptionalPage('calendar', lang);
const CalendarContent = calendar?.Content;

const butonAlb =
  'inline-block bg-white px-7 py-3.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-swiss transition-colors hover:bg-white/90';
---

<Base lang={lang} title={`${t('activities.title')} · ${t('site.name')}`} description={t('activities.description')}>
  <PageHero title={t('activities.title')} intro={t('activities.intro')} />

  <!-- Următorul eveniment -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20" aria-labelledby="urmeaza">
    <h2 id="urmeaza" class="eyebrow text-swiss">{t('activities.upcoming')}</h2>
    {
      next && NextContent ? (
        <div class="mt-6 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-14">
          <div>
            <p class="font-sans text-sm font-semibold tracking-[0.06em] text-muted">
              <time datetime={next.data.date.toISOString().slice(0, 10)}>
                {formatDate(next.data.date, lang)}
              </time>
              {next.data.location && <span class="mx-2 text-rule">·</span>}
              {next.data.location}
            </p>
            <h3 class="mt-2 font-serif text-3xl font-bold leading-tight text-ink sm:text-4xl">
              {next.data.title}
            </h3>
            <div class="prose-n mt-5 max-w-[58ch] text-ink">
              <NextContent />
            </div>
          </div>
          {next.data.image && (
            <Foto src={next.data.image} alt={next.data.imageAlt ?? ''} class="aspect-[4/3] lg:aspect-auto lg:h-full" />
          )}
        </div>
      ) : (
        <p class="mt-6 max-w-[58ch] text-[1.0625rem] leading-relaxed text-muted">
          {t('activities.noUpcoming')}
        </p>
      )
    }

    {
      upcoming.length > 1 && (
        <ul class="mt-14 divide-y divide-rule border-t border-rule">
          {upcoming.slice(1).map((event) => (
            <li class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-4">
              <span class="font-sans text-xs tracking-[0.06em] text-swiss">
                <time datetime={event.data.date.toISOString().slice(0, 10)}>
                  {formatDate(event.data.date, lang)}
                </time>
              </span>
              <span class="font-serif text-lg font-bold text-ink">{event.data.title}</span>
              {event.data.location && <span class="text-sm text-muted">{event.data.location}</span>}
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- Calendarul anual (editabil din src/content/pagini/ro/calendar.md) -->
  {
    calendar && CalendarContent && (
      <section class="border-y border-rule bg-swiss/[0.04]" aria-labelledby="calendar-anual">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
          <h2 id="calendar-anual" class="font-serif text-2xl font-bold text-ink sm:text-3xl">
            {calendar.entry.data.title}
          </h2>
          <div class="prose-n mt-6 max-w-[72ch] text-ink">
            <CalendarContent />
          </div>
        </div>
      </section>
    )
  }

  <!-- Activitate permanentă: bandă roșie -->
  <section class="bg-swiss text-white" aria-labelledby="permanent">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:py-16">
      <p class="eyebrow text-white/75">{t('psaltica.title')}</p>
      <h2 id="permanent" class="mt-3 max-w-[24ch] font-serif text-2xl font-bold leading-snug sm:text-3xl">
        {t('activities.permanent')}
      </h2>
      <p class="mt-4 max-w-[58ch] text-base leading-relaxed text-white/85">
        {t('activities.permanentText')}
      </p>
      <p class="mt-7">
        <a href={localePath(lang, '/psaltica/')} class={butonAlb}>{t('activities.permanentLink')}</a>
      </p>
    </div>
  </section>

  <!-- Evenimente recente -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:py-20" aria-labelledby="recente">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <h2 id="recente" class="font-serif text-2xl font-bold text-ink sm:text-3xl">
        {t('activities.past')}
      </h2>
      <a
        href={localePath(lang, '/amintiri/')}
        class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-swiss underline decoration-swiss/40 underline-offset-4 hover:decoration-swiss"
      >
        {t('archive.allMemories')}
      </a>
    </div>
    <div class="mt-10 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {past.slice(0, 3).map((event) => <EventCard event={event} lang={lang} />)}
    </div>
  </section>
</Base>

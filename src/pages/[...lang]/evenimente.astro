---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EventRow from '../../components/EventRow.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, type UIKey } from '../../i18n';
import { getEvents, splitEvents, getOptionalPage } from '../../lib/content';
import { indiceVreme } from '../../lib/vremi';
import psalticaLogo from '../../assets/nepsis_psaltica_logo.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

// Împărțirea se face automat la fiecare build, după data evenimentului.
const { upcoming, past } = splitEvents(await getEvents(lang));

// Evenimentele viitoare, grupate pe vremile anului frăției: lista se citește ca
// anul care vine, nu ca un tabel. Vremea în care ne aflăm primește titlul roșu.
const acum = new Date();
const vremeaAcum = indiceVreme(acum);
const anulAcum = acum.getUTCFullYear();
type Grup = { vreme: number; an: number; evenimente: typeof upcoming };
const grupuri: Grup[] = [];
for (const ev of upcoming) {
  const vreme = indiceVreme(ev.data.date);
  const an = ev.data.date.getUTCFullYear();
  const ultimul = grupuri.at(-1);
  if (ultimul && ultimul.vreme === vreme && ultimul.an === an) ultimul.evenimente.push(ev);
  else grupuri.push({ vreme, an, evenimente: [ev] });
}
const cuMajuscula = (s: string) => s.charAt(0).toLocaleUpperCase(lang) + s.slice(1);

// Calendarul anual, editabil ca simplu fișier Markdown (opțional).
const calendar = await getOptionalPage('calendar', lang);
const CalendarContent = calendar?.Content;
---

<Base lang={lang} title={`${t('activities.title')} · ${t('site.name')}`} description={t('activities.description')}>
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <!--
      Titlul paginii și fraza de întâmpinare au fost scoase la cererea
      utilizatorului. „Următorul eveniment” urcă în locul lor ca h1: pagina
      trebuie să păstreze un titlu de nivel întâi pentru cititoarele de ecran
      și pentru indexare, iar numele rubricii rămâne în <title>.
    -->
    <section aria-labelledby="urmeaza">
      <h1 id="urmeaza" class="titlu-mare">{t('activities.upcoming')}</h1>
      {
        upcoming.length === 0 ? (
          <p class="mt-6 max-w-[62ch] text-umbra">{t('activities.noUpcoming')}</p>
        ) : (
          <div class="mt-12 space-y-14">
            {grupuri.map((g) => (
              <div>
                <h2
                  class:list={[
                    'font-serif text-[1.375rem] italic',
                    g.vreme === vremeaAcum && g.an === anulAcum ? 'text-candela' : 'text-cerneala',
                  ]}
                >
                  {cuMajuscula(t(`vreme.${g.vreme}` as UIKey))}, {g.an}
                </h2>
                <div class="mt-5 divide-y divide-linie border-t border-linie">
                  {g.evenimente.map((ev) => (
                    <div class="py-9">
                      <EventRow event={ev} lang={lang} detailed={ev === upcoming[0]} headingLevel="h3" />
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        )
      }
    </section>

    <!-- Calendarul anual (editabil din src/content/pagini/ro/calendar.md) -->
    {
      calendar && CalendarContent && (
        <section class="mt-24" aria-labelledby="calendar-anual">
          <h2 id="calendar-anual" class="titlu">{calendar.entry.data.title}</h2>
          <div class="proza proza-lata mt-8">
            <CalendarContent />
          </div>
        </section>
      )
    }

    <!-- Activitate permanentă -->
    <section
      class="mt-24 border-t border-linie pt-12 md:grid md:grid-cols-[14rem_minmax(0,1fr)] md:gap-12"
      aria-labelledby="permanent"
    >
      <Image
        src={psalticaLogo}
        alt={t('psaltica.logoAlt')}
        widths={[280, 560]}
        sizes="14rem"
        format="webp"
        quality={72}
        loading="lazy"
        decoding="async"
        class="block h-auto w-40 border border-linie md:w-full"
      />
      <div class="mt-8 md:mt-0">
        <h2 id="permanent" class="titlu-mic">{t('activities.permanent')}</h2>
        <p class="mt-3 max-w-[62ch]">{t('activities.permanentText')}</p>
        <p class="mt-4">
          <a href={localePath(lang, '/psaltica/')} class="secundar">{t('activities.permanentLink')}</a>
        </p>
      </div>
    </section>

    <!-- Evenimente recente: doar ultimele trei -->
    <section class="mt-24" aria-labelledby="recente">
      <h2 id="recente" class="titlu">{t('activities.past')}</h2>
      <div class="mt-8 divide-y divide-linie border-y border-linie">
        {
          past.slice(0, 3).map((ev) => (
            <div class="py-8">
              <EventRow event={ev} lang={lang} headingLevel="h3" />
            </div>
          ))
        }
      </div>
      <p class="mt-8">
        <a href={localePath(lang, '/amintiri/')} class="secundar">{t('home.seeMemories')}</a>
      </p>
    </section>
  </div>
</Base>

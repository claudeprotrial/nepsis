---
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, withBase, type UIKey } from '../../i18n';
import { getMembers } from '../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const members = await getMembers();
---

<Base lang={lang} title={`${t('members.title')} · ${t('site.name')}`} description={t('members.description')}>
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <header class="max-w-[44rem]">
      <h1 class="titlu-mare">{t('members.heading')}</h1>
      <p class="mt-3 font-serif text-[1.375rem] text-umbra italic">{t('members.subtitle')}</p>
    </header>

    <!--
      Portretele rămân rotunde: arcul e forma locurilor și a adunărilor, cercul e
      forma chipurilor. Locul fotografiei e rezervat chiar dacă deocamdată nimeni
      n-are poză — când se adaugă `photo` în fișierul persoanei, imaginea intră
      direct în cerc, fără altă modificare.
    -->
    <ul class="mt-14 grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-3 lg:grid-cols-4">
      {
        members.map((member) => (
          <li class="text-center">
            <img
              src={withBase(member.data.photo ?? '/img/membri/placeholder.png')}
              alt={member.data.photo ? member.data.name : t('members.missingPhoto')}
              loading="lazy"
              width="240"
              height="240"
              class="mx-auto aspect-square w-32 rounded-full border border-linie object-cover sm:w-36"
            />
            <h2 class="mt-4 font-serif text-[1.375rem] leading-tight font-normal">{member.data.name}</h2>
            <p class="mt-1 text-sm">{t(`members.role.${member.data.role}` as UIKey)}</p>
            {member.data.parish && (
              <p class="text-sm text-umbra">
                {/* Părintele răspunde de frăție la nivel de țară, nu de o parohie, deci la el nu punem prefixul „Parohia”. */}
                {member.data.role === 'responsabil'
                  ? member.data.parish
                  : `${t('members.parish')} ${member.data.parish}`}
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <p class="mt-16 max-w-[62ch] text-umbra">
      {t('members.more')}
      <a href={localePath(lang, '/amintiri/')} class="text-cerneala underline decoration-candela underline-offset-[6px] hover:decoration-2">{t('members.morePage')}</a>.
    </p>
  </div>
</Base>

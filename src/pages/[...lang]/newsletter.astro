---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const formUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLScUYtvr7ZKbcWlpaoJAHWHD7Z9M13pSpaMhk--tf4eGIky3sA/viewform';
---

<Base lang={lang} title={`${t('newsletter.title')} · ${t('site.name')}`} description={t('newsletter.description')}>
  <PageHeader title={t('newsletter.heading')} intro={t('newsletter.text')} />

  <div class="mx-auto max-w-3xl px-4 py-14 sm:py-20">
    <div class="overflow-hidden rounded-sm border border-rule bg-white">
      <iframe
        src={`${formUrl}?embedded=true`}
        width="100%"
        height="800"
        loading="lazy"
        title={t('newsletter.heading')}></iframe>
    </div>

    <p class="mt-6 text-[0.9375rem] leading-relaxed text-muted">
      {t('newsletter.fallback')}
      <a
        href={formUrl}
        target="_blank"
        rel="noopener"
        class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
      >
        {t('newsletter.openForm')}
      </a>
    </p>
  </div>
</Base>

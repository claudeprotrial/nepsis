---
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);

const formUrl =
  'https://docs.google.com/forms/d/e/1FAIpQLScUYtvr7ZKbcWlpaoJAHWHD7Z9M13pSpaMhk--tf4eGIky3sA/viewform';
---

<Base lang={lang} title={`${t('newsletter.title')} · ${t('site.name')}`} description={t('newsletter.description')}>
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <h1 class="titlu-mare max-w-[44rem]">{t('newsletter.heading')}</h1>
    <p class="mt-5 max-w-[62ch]">{t('newsletter.text')}</p>

    <div class="mt-10 max-w-3xl border border-linie bg-lumina">
      <iframe src={`${formUrl}?embedded=true`} width="100%" height="800" loading="lazy" title={t('newsletter.heading')}></iframe>
    </div>

    <p class="mt-6 max-w-[62ch] text-umbra">
      {t('newsletter.fallback')}
      <a href={formUrl} target="_blank" rel="noopener" class="text-cerneala underline decoration-candela underline-offset-[6px] hover:decoration-2">
        {t('newsletter.openForm')}
      </a>
    </p>
  </div>
</Base>

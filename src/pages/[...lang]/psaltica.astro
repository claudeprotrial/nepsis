---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';
import psalticaLogo from '../../assets/nepsis_psaltica_logo.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('psaltica', lang);
---

<Base
  lang={lang}
  title={`${t('psaltica.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('psaltica.description')}
  ogImage="/psaltica/img/nepsis_psaltica_logo.jpg"
>
  <PageHeader title={t('psaltica.title')} />

  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
    <div class="gap-12 md:grid md:grid-cols-[20rem_1fr] lg:gap-16">
      <figure class="mx-auto max-w-[20rem] md:mx-0">
        <Image
          src={psalticaLogo}
          alt={t('psaltica.logoAlt')}
          widths={[400, 700]}
          sizes="20rem"
          format="webp"
          quality={74}
          fetchpriority="high"
          decoding="async"
          class="w-full rounded-sm"
        />
      </figure>
      <div class="prose-j mt-10 max-w-[62ch] text-ink md:mt-0">
        <Content />
      </div>
    </div>
  </div>

  <section class="border-t border-rule bg-paper-deep" aria-labelledby="marturii">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <SectionTitle id="marturii" bg="paper-deep">{t('psaltica.testimonials')}</SectionTitle>

      <!-- Harta interactivă (ArcGIS) se încarcă abia la click, ca pagina să rămână rapidă. -->
      <div
        id="marturii-fatada"
        class="mt-10 flex h-[500px] items-center justify-center overflow-hidden rounded-sm border border-rule bg-paper"
        data-src="https://storymaps.arcgis.com/stories/e2f319110254454fad115d0c30b00d1f?cover=false"
        data-title={t('psaltica.testimonials')}
      >
        <button
          type="button"
          class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          {t('psaltica.testimonials')} →
        </button>
      </div>
      <noscript>
        <p class="mt-4">
          <a
            href="https://storymaps.arcgis.com/stories/e2f319110254454fad115d0c30b00d1f"
            target="_blank"
            rel="noopener"
            class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4"
          >
            {t('psaltica.testimonials')}
          </a>
        </p>
      </noscript>
    </div>
  </section>
</Base>

<script>
  // Înlocuiește fațada cu iframe-ul ArcGIS abia la click.
  const fatada = document.getElementById('marturii-fatada');
  fatada?.querySelector('button')?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = fatada.dataset.src ?? '';
    iframe.title = fatada.dataset.title ?? '';
    iframe.width = '100%';
    iframe.height = '500';
    iframe.allowFullscreen = true;
    iframe.allow = 'geolocation';
    fatada.replaceChildren(iframe);
  });
</script>

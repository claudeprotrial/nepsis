---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';
import psalticaLogo from '../../assets/nepsis_psaltica_logo.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('psaltica', lang);
---

<Base
  lang={lang}
  title={`${t('psaltica.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('psaltica.description')}
  ogImage="/psaltica/img/nepsis_psaltica_logo.jpg"
>
  <PageHero title={t('psaltica.title')} />

  <div class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <div class="gap-12 md:grid md:grid-cols-[20rem_1fr] lg:gap-16">
      <figure class="mx-auto max-w-[20rem] md:mx-0">
        <Image
          src={psalticaLogo}
          alt={t('psaltica.logoAlt')}
          widths={[400, 700]}
          sizes="20rem"
          format="webp"
          quality={76}
          fetchpriority="high"
          decoding="async"
          class="w-full"
        />
      </figure>
      <div class="prose-n mt-10 max-w-[62ch] text-ink md:mt-0">
        <Content />
      </div>
    </div>
  </div>

  <section class="bg-swiss text-white" aria-labelledby="marturii">
    <div class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
      <h2 id="marturii" class="font-serif text-2xl font-bold sm:text-3xl">{t('psaltica.testimonials')}</h2>

      <!-- Harta interactivă (ArcGIS) se încarcă abia la click, ca pagina să rămână rapidă. -->
      <div
        id="marturii-fatada"
        class="mt-8 flex h-[500px] items-center justify-center overflow-hidden border border-white/30 bg-swiss-deep"
        data-src="https://storymaps.arcgis.com/stories/e2f319110254454fad115d0c30b00d1f?cover=false"
        data-title={t('psaltica.testimonials')}
      >
        <button
          type="button"
          class="bg-white px-7 py-3.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-swiss transition-colors hover:bg-white/90"
        >
          {t('psaltica.testimonials')} →
        </button>
      </div>
      <noscript>
        <p class="mt-4">
          <a
            href="https://storymaps.arcgis.com/stories/e2f319110254454fad115d0c30b00d1f"
            target="_blank"
            rel="noopener"
            class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-white underline underline-offset-4"
          >
            {t('psaltica.testimonials')}
          </a>
        </p>
      </noscript>
    </div>
  </section>
</Base>

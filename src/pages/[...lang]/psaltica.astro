---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';
import psalticaLogo from '../../assets/nepsis_psaltica_logo.jpg';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('psaltica', lang);
---

<Base
  lang={lang}
  title={`${t('psaltica.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('psaltica.description')}
  ogImage="/psaltica/img/nepsis_psaltica_logo.jpg"
>
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <h1 class="titlu-mare max-w-[44rem]">{t('psaltica.title')}</h1>

    <div class="mt-12 gap-14 lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
      <Image
        src={psalticaLogo}
        alt={t('psaltica.logoAlt')}
        widths={[400, 700, 1000]}
        sizes="(min-width: 1024px) 34vw, 100vw"
        format="webp"
        quality={72}
        fetchpriority="high"
        decoding="async"
        class="block h-auto w-full max-w-md border border-linie"
      />
      <div class="proza mt-10 lg:mt-0">
        <Content />
      </div>
    </div>

    <section class="mt-24 border-t border-linie pt-12" aria-labelledby="marturii">
      <h2 id="marturii" class="titlu">{t('psaltica.testimonials')}</h2>
      <!-- Harta interactivă (ArcGIS) se încarcă abia la click, ca pagina să rămână rapidă. -->
      <div
        id="marturii-fatada"
        class="mt-8 flex h-[500px] items-center justify-center border border-linie bg-zi"
        data-src="https://storymaps.arcgis.com/stories/e2f319110254454fad115d0c30b00d1f?cover=false"
        data-title={t('psaltica.testimonials')}
      >
        <button type="button" class="candela">{t('psaltica.testimonials')}</button>
      </div>
      <noscript>
        <p class="mt-4">
          <a
            href="https://storymaps.arcgis.com/stories/e2f319110254454fad115d0c30b00d1f"
            target="_blank"
            rel="noopener"
            class="secundar"
          >
            {t('psaltica.testimonials')}
          </a>
        </p>
      </noscript>
    </section>
  </div>
</Base>

<script>
  // Înlocuiește fațada cu iframe-ul ArcGIS abia la click.
  const fatada = document.getElementById('marturii-fatada');
  fatada?.querySelector('button')?.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = fatada.dataset.src ?? '';
    iframe.title = fatada.dataset.title ?? '';
    iframe.width = '100%';
    iframe.height = '500';
    iframe.allowFullscreen = true;
    iframe.allow = 'geolocation';
    fatada.replaceChildren(iframe);
  });
</script>

---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, withBase, type UIKey } from '../../i18n';
import { getMembers } from '../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const members = await getMembers();
---

<Base lang={lang} title={`${t('members.title')} · ${t('site.name')}`} description={t('members.description')}>
  <PageHeader title={t('members.heading')} intro={t('members.subtitle')} />

  <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
    <!--
      Portrete dreptunghiulare, nu rotunde: un cerc taie umerii și transformă
      oamenii în avataruri de aplicație. Formatul 4:5 e formatul unei fotografii.
    -->
    <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
      {
        members.map((member) => (
          <li>
            <img
              src={withBase(member.data.photo ?? '/img/membri/placeholder.png')}
              alt={member.data.photo ? member.data.name : t('members.missingPhoto')}
              loading="lazy"
              width="320"
              height="400"
              class="aspect-[4/5] w-full rounded-sm bg-paper-deep object-cover"
            />
            <p class="eyebrow mt-3">{t(`members.role.${member.data.role}` as UIKey)}</p>
            <h2 class="mt-1 font-serif text-lg font-bold leading-snug text-ink">{member.data.name}</h2>
            <p class="meta mt-1">
              {t('members.parish')} {member.data.parish}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="mt-14 max-w-[60ch] text-[0.9375rem] leading-relaxed text-muted">
      {t('members.more')}
      <a
        href={localePath(lang, '/amintiri/')}
        class="text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
      >
        {t('members.morePage')}</a
      >.
    </p>
  </div>
</Base>

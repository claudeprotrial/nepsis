---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Foto from '../../components/Foto.astro';
import { langStaticPaths, localeFromParam, localePath, useTranslations, type UIKey } from '../../i18n';
import { getMembers } from '../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const members = await getMembers();
---

<Base lang={lang} title={`${t('members.title')} · ${t('site.name')}`} description={t('members.description')}>
  <PageHero title={t('members.heading')} intro={t('members.subtitle')} />

  <div class="mx-auto max-w-7xl px-4 py-16 sm:py-20">
    <!--
      Portretele rămân în culorile lor: pe o pagină de membri contează să
      recunoști omul, nu să se potrivească pozele între ele. Uniformitatea vine
      din același format 4:5 și din linia roșie de sub rol.
    -->
    <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
      {
        members.map((member) => (
          <li>
            <Foto
              src={member.data.photo ?? '/img/membri/placeholder.png'}
              alt={member.data.photo ? member.data.name : t('members.missingPhoto')}
              natural
              class="aspect-[4/5] bg-swiss/5"
            />
            <h2 class="mt-3 font-serif text-lg font-bold leading-snug text-ink">{member.data.name}</h2>
            <p class="mt-1 border-t-2 border-swiss pt-1.5 font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.12em] text-swiss">
              {t(`members.role.${member.data.role}` as UIKey)}
            </p>
            <p class="mt-1 text-sm text-muted">
              {t('members.parish')} {member.data.parish}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="mt-14 max-w-[60ch] text-[0.9375rem] leading-relaxed text-muted">
      {t('members.more')}
      <a
        href={localePath(lang, '/amintiri/')}
        class="text-swiss underline decoration-swiss/40 underline-offset-4 hover:decoration-swiss"
      >
        {t('members.morePage')}</a
      >.
    </p>
  </div>
</Base>

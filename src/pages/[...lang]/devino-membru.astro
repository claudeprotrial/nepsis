---
import Base from '../../layouts/Base.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('devino-membru', lang);
---

<Base lang={lang} title={`${t('join.title')} · ${t('site.name')}`} description={entry.data.description ?? t('join.description')}>
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-16">
    <h1 class="titlu-mare max-w-[44rem]">{entry.data.title}</h1>
    <div class="proza mt-10">
      <Content />
    </div>
    <p class="mt-12">
      <!-- Butonul asamblează adresa la click — nu există „mailto:” în clar în HTML. -->
      <a href="#" class="email-protejat-buton candela" data-x="nepsis.ch" data-y="mitropolia" data-z="eu">
        {t('join.cta')}
      </a>
    </p>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.email-protejat-buton').forEach((el) => {
    el.addEventListener('click', (ev) => {
      ev.preventDefault();
      const { x, y, z } = el.dataset;
      window.location.href = `mailto:${x}@${y}.${z}`;
    });
  });
</script>

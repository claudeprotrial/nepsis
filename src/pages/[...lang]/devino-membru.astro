---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { langStaticPaths, localeFromParam, useTranslations } from '../../i18n';
import { getPage } from '../../lib/content';

export function getStaticPaths() {
  return langStaticPaths();
}

const lang = localeFromParam(Astro.params.lang);
const t = useTranslations(lang);
const { entry, Content } = await getPage('devino-membru', lang);
---

<Base
  lang={lang}
  title={`${t('join.title')} · ${t('site.name')}`}
  description={entry.data.description ?? t('join.description')}
>
  <PageHeader title={entry.data.title} />

  <div class="mx-auto max-w-[62ch] px-4 py-14 sm:py-20">
    <div class="prose-j text-ink">
      <Content />
    </div>

    <p class="mt-12 border-t border-rule pt-8">
      <!-- Legătura asamblează adresa la click — nu există „mailto:” în clar în HTML. -->
      <a
        href="#"
        class="email-protejat-buton font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        data-x="nepsis.ch"
        data-y="mitropolia"
        data-z="eu"
      >
        {t('join.cta')} →
      </a>
    </p>
  </div>
</Base>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.email-protejat-buton').forEach((el) => {
    el.addEventListener('click', (ev) => {
      ev.preventDefault();
      const { x, y, z } = el.dataset;
      window.location.href = `mailto:${x}@${y}.${z}`;
    });
  });
</script>

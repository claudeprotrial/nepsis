---
import Base from '../layouts/Base.astro';
import { defaultLocale, useTranslations, localePath } from '../i18n';

const lang = defaultLocale;
const t = useTranslations(lang);
---

<Base lang={lang} title={`${t('notFound.title')} · ${t('site.name')}`} description={t('notFound.text')}>
  <div class="mx-auto max-w-[48ch] px-4 py-24 text-center sm:py-32">
    <p class="font-serif text-[5rem] font-bold leading-none text-rule sm:text-[7rem]">404</p>
    <h1 class="mt-6 font-serif text-2xl font-bold text-ink sm:text-3xl">{t('notFound.title')}</h1>
    <p class="mt-3 text-[1.0625rem] leading-relaxed text-muted">{t('notFound.text')}</p>
    <p class="mt-8">
      <a
        href={localePath(lang, '/')}
        class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
      >
        {t('notFound.home')}
      </a>
    </p>
  </div>
</Base>

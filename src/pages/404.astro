---
import Base from '../layouts/Base.astro';
import { defaultLocale, useTranslations, localePath } from '../i18n';

const lang = defaultLocale;
const t = useTranslations(lang);
---

<Base lang={lang} title={`${t('notFound.title')} · ${t('site.name')}`} description={t('notFound.text')}>
  <div class="mx-auto max-w-7xl px-4 py-24 md:py-32">
    <p class="font-serif text-[5rem] leading-none font-light text-umbra tabular-nums">404</p>
    <h1 class="titlu mt-6 max-w-[30rem]">{t('notFound.title')}</h1>
    <p class="mt-4 max-w-[62ch] text-umbra">{t('notFound.text')}</p>
    <p class="mt-10">
      <a href={localePath(lang, '/')} class="candela">{t('notFound.home')}</a>
    </p>
  </div>
</Base>

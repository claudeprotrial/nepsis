---
import '@fontsource-variable/inter';
import '@fontsource/cardo/400.css';
import '@fontsource/cardo/400-italic.css';
import '@fontsource/cardo/700.css';
import '../styles/global.css';
import Masthead from '../components/Masthead.astro';
import Colophon from '../components/Colophon.astro';
import { type Locale, useTranslations, localePath, stripLocale, locales, withBase } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  ogImage?: string;
}

const { lang, title, description, ogImage = '/img/logo-small.jpg' } = Astro.props;
const t = useTranslations(lang);
const pathNoLocale = stripLocale(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
// Pagina 404 există doar în română — fără alternative hreflang.
const hasAlternates = !pathNoLocale.startsWith('/404');
const ogLocales: Record<Locale, string> = { ro: 'ro_RO', fr: 'fr_CH', en: 'en_GB', de: 'de_CH' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href={withBase('/img/sigla-nepsis.png')} type="image/png" />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    {
      hasAlternates &&
        locales.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(localePath(l, pathNoLocale), Astro.site).href} />
        ))
    }
    {hasAlternates && <link rel="alternate" hreflang="x-default" href={new URL(withBase(pathNoLocale), Astro.site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(withBase(ogImage), Astro.site).href} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#continut"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      {t('nav.skipToContent')}
    </a>
    <Masthead lang={lang} />
    <main id="continut" class="flex-1">
      <slot />
    </main>
    <Colophon lang={lang} />
    <script>
      // Asamblează adresele de e-mail protejate abia la click (anti-spam):
      // adresa nu apare nicăieri în HTML în clar.
      document.addEventListener('click', (ev) => {
        const el = (ev.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a.email-protejat');
        if (!el) return;
        ev.preventDefault();
        const { x, y, z } = el.dataset;
        window.location.href = `mailto:${x}@${y}.${z}`;
      });
    </script>
  </body>
</html>

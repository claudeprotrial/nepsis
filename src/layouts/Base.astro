---
// Newsreader: titluri și cursiva rubricii — italicul ei e caligrafic, singurul
// comportament tipografic care rimează cu sigla desenată de mână. Axa optică dă un
// desen fin la 64px și o literă robustă la 17px, din același fișier.
import '@fontsource-variable/newsreader/standard.css';
import '@fontsource-variable/newsreader/standard-italic.css';
// Instrument Sans: textul curent și interfața.
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Locale, useTranslations, localePath, stripLocale, locales, withBase } from '../i18n';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  ogImage?: string;
}

const { lang, title, description, ogImage = '/img/logo-small.jpg' } = Astro.props;
const t = useTranslations(lang);
const pathNoLocale = stripLocale(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
// Pagina 404 există doar în română — fără alternative hreflang.
const hasAlternates = !pathNoLocale.startsWith('/404');
const ogLocales: Record<Locale, string> = { ro: 'ro_RO', fr: 'fr_CH', en: 'en_GB', de: 'de_CH' };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {/* Marca Nepsis. `favicon.ico` are trei mărimi, iar cea mică e altă imagine:
        la 16px — mărimea reală într-o filă de browser — cuvântul „NEPSIS” are șase
        litere într-un pătrat de 16 pixeli și devine o pată, așa că acolo punem doar
        steaua-cruce de sub el, decupată din logo. De la 32px încolo încape logoul
        întreg. Marginea albă de prisos e tăiată la generare, ca marca să umple
        pătratul. */}
    <link rel="icon" href={withBase('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <link rel="icon" href={withBase('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <meta name="generator" content={Astro.generator} />
    {
      hasAlternates &&
        locales.map((l) => (
          <link rel="alternate" hreflang={l} href={new URL(localePath(l, pathNoLocale), Astro.site).href} />
        ))
    }
    {hasAlternates && <link rel="alternate" hreflang="x-default" href={new URL(withBase(pathNoLocale), Astro.site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocales[lang]} />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(withBase(ogImage), Astro.site).href} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="flex min-h-screen flex-col bg-lumina text-cerneala">
    <a
      href="#continut"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:bg-cerneala focus:px-4 focus:py-2 focus:text-lumina"
    >
      {t('nav.skipToContent')}
    </a>
    <Header lang={lang} />
    <main id="continut" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Asamblează adresele de e-mail protejate abia la click (anti-spam):
      // adresa nu apare nicăieri în HTML în clar.
      document.addEventListener('click', (ev) => {
        const el = (ev.target as HTMLElement | null)?.closest<HTMLAnchorElement>('a.email-protejat');
        if (!el) return;
        ev.preventDefault();
        const { x, y, z } = el.dataset;
        window.location.href = `mailto:${x}@${y}.${z}`;
      });
    </script>
  </body>
</html>

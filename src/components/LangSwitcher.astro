---
import { type Locale, useTranslations, localePath, stripLocale, locales } from '../i18n';

/**
 * Selectorul de limbă stă pe banda roșie, deci e alb; limba curentă e subliniată,
 * nu colorată — pe roșu nu mai avem o a doua culoare de rezervă.
 */
interface Props {
  lang: Locale;
  class?: string;
}

const { lang, class: extra = '' } = Astro.props;
const t = useTranslations(lang);
// Pagina 404 există doar în română — selectorul duce atunci la paginile principale.
const rawPath = stripLocale(Astro.url.pathname);
const path = rawPath.startsWith('/404') ? '/' : rawPath;
const names: Record<Locale, string> = { ro: 'Română', fr: 'Français', en: 'English', de: 'Deutsch' };
---

<nav aria-label={t('nav.language')} class:list={['flex items-center gap-2.5', extra]}>
  {
    locales.map((l) => (
      <a
        href={localePath(l, path)}
        hreflang={l}
        lang={l}
        aria-current={l === lang ? 'true' : undefined}
        title={names[l]}
        class:list={[
          'font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.12em] transition-colors',
          l === lang ? 'underline decoration-2 underline-offset-4' : 'opacity-70 hover:opacity-100',
        ]}
      >
        {l}
      </a>
    ))
  }
</nav>

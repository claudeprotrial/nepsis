---
import { type Locale, useTranslations, localePath, stripLocale, locales } from '../i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Pagina 404 există doar în română — selectorul duce atunci la paginile principale.
const rawPath = stripLocale(Astro.url.pathname);
const path = rawPath.startsWith('/404') ? '/' : rawPath;
const names: Record<Locale, string> = { ro: 'Română', fr: 'Français', en: 'English', de: 'Deutsch' };
---

<nav aria-label={t('nav.language')} class="flex items-center gap-3 text-[0.8125rem]">
  {
    locales.map((l) => (
      <a
        href={localePath(l, path)}
        hreflang={l}
        lang={l}
        aria-current={l === lang ? 'true' : undefined}
        title={names[l]}
        class:list={[
          'py-1 uppercase transition-colors',
          l === lang
            ? 'text-cerneala underline decoration-cerneala underline-offset-[5px]'
            : 'text-umbra hover:text-cerneala',
        ]}
      >
        {l}
      </a>
    ))
  }
</nav>

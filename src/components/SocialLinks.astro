---

<ul class:list={['flex items-center gap-2', extra]}>
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          target="_blank"
          rel="noopener"
          aria-label={l.label}
          title={l.label}
          class="flex h-10 w-10 items-center justify-center text-umbra transition-colors hover:text-cerneala"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
            <path d={l.path} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

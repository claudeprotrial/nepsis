---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { withBase } from '../i18n';
import { dimensiuni } from '../lib/imagini';

/**
 * Arcul: fereastra de biserică, singura abatere de la dreptunghi din tot site-ul.
 * Se folosește cel mult o dată pe pagină.
 *
 * Containerul ia exact proporțiile fotografiei, deci imaginea nu e niciodată
 * tăiată — se rotunjesc doar colțurile de sus. La portrete și pătrate arcul e un
 * semicerc întreg. La fotografiile late e un arc segmentat, mai jos: un semicerc
 * întreg peste o poză de grup ar tăia capetele oamenilor de la margini.
 */
interface Props {
  /** Cale din public/ (fotografiile adăugate de editori). */
  src?: string;
  /** Imagine importată din src/assets, optimizată la build. */
  imagine?: ImageMetadata;
  alt: string;
  /** „Se face lumină în fereastră” — momentul de deschidere, doar pe prima pagină. */
  lumina?: boolean;
  eager?: boolean;
  sizes?: string;
  class?: string;
}

const {
  src,
  imagine,
  alt,
  lumina = false,
  eager = false,
  sizes = '(min-width: 768px) 50vw, 100vw',
  class: extra = '',
} = Astro.props;

const d = imagine ? { w: imagine.width, h: imagine.height } : src ? await dimensiuni(src) : null;
const w = d?.w ?? 4;
const h = d?.h ?? 3;
const proportie = w / h;
// Raza verticală, ca procent din înălțime: semicerc la portrete, arc jos la fotografiile late.
const ridicare = proportie <= 1.05 ? 50 * proportie : Math.min(18, 14 * proportie);
const r = `${ridicare.toFixed(2)}%`;
const stil = `aspect-ratio: ${w} / ${h}; border-radius: 50% 50% 4px 4px / ${r} ${r} 4px 4px;`;
---

<div class:list={['arc', lumina && 'arc--lumina', extra]} style={stil}>
  {
    imagine ? (
      <Image
        src={imagine}
        alt={alt}
        widths={[640, 960, 1400, 1920]}
        sizes={sizes}
        format="webp"
        quality={74}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      <img
        src={withBase(src ?? '')}
        alt={alt}
        width={d?.w}
        height={d?.h}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
      />
    )
  }
</div>

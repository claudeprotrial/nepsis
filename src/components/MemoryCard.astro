---
import Foto from './Foto.astro';
import Emblema from './Emblema.astro';
import { type Locale, formatDate } from '../i18n';
import type { CollectionEntry } from 'astro:content';

/**
 * O amintire în grilă. Pe câmp roșu (`pe-rosu`) litera trece pe alb, iar
 * fotografia tratată în roșu se lipește de fond; pe alb, fotografia rămâne
 * tot roșie, dar textul e negru.
 */
interface Props {
  memory: CollectionEntry<'amintiri'>;
  lang: Locale;
  href: string;
  peRosu?: boolean;
}

const { memory, lang, href, peRosu = false } = Astro.props;
const cover = memory.data.images[0];
---

<article>
  <a href={href} class="group block">
    {
      cover ? (
        <Foto
          src={cover.src}
          alt={cover.alt}
          class="aspect-[4/3]"
          imgClass="transition-transform duration-500 group-hover:scale-[1.05]"
        />
      ) : (
        <div
          class:list={[
            'flex aspect-[4/3] items-center justify-center',
            peRosu ? 'bg-swiss-deep' : 'bg-swiss/10',
          ]}
        >
          {/* Amintire fără fotografii: sigla ține locul, mai demn decât un cuvânt. */}
          <Emblema class:list={['h-16 w-16', peRosu ? 'text-white/25' : 'text-swiss/25']} />
        </div>
      )
    }
    <h3
      class:list={[
        'mt-3 font-serif text-lg font-bold leading-snug underline-offset-4 group-hover:underline sm:text-xl',
        peRosu ? 'text-white decoration-white/50' : 'text-ink decoration-swiss/40',
      ]}
    >
      {memory.data.title}
    </h3>
    <p
      class:list={[
        'mt-1 font-sans text-xs tracking-[0.06em]',
        peRosu ? 'text-white/70' : 'text-muted',
      ]}
    >
      {
        memory.data.date && memory.data.showDate
          ? formatDate(memory.data.date, lang)
          : memory.data.year
      }
    </p>
  </a>
</article>

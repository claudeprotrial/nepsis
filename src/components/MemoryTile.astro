---
import { type Locale, formatDate, withBase } from '../i18n';
import type { CollectionEntry } from 'astro:content';

/**
 * O amintire în grila de galerie: fotografia de copertă, titlul și data.
 * Textul întreg stă pe pagina proprie a amintirii — în index el ar fi făcut
 * din galerie un teanc de articole și ar fi randat zeci de pagini de Markdown
 * într-un singur fișier HTML.
 *
 * Titlurile lungi se taie vizual la trei rânduri (line-clamp), ca rândurile grilei
 * să nu devină zimțate; textul rămâne întreg în DOM, deci cititoarele de ecran îl aud
 * tot, iar titlul complet se vede pe pagina amintirii.
 */
interface Props {
  memory: CollectionEntry<'amintiri'>;
  lang: Locale;
  href: string;
}

const { memory, lang, href } = Astro.props;
const cover = memory.data.images[0];
---

<article>
  <a href={href} class="group block focus:outline-none">
    {
      cover ? (
        <div class="overflow-hidden rounded-xl bg-stone-100">
          <img
            src={withBase(cover.src)}
            alt={cover.alt}
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
          />
        </div>
      ) : (
        /* Amintire fără fotografii: un panou colorat ține grila aliniată. */
        <div class="flex aspect-[4/3] items-center justify-center rounded-xl bg-brand-50 p-4">
          <span class="font-serif text-lg text-brand-300">Nepsis</span>
        </div>
      )
    }
    <h3
      class="mt-3 line-clamp-3 font-serif text-base font-bold leading-snug text-brand-950 decoration-brand-300 underline-offset-4 group-hover:underline group-focus-visible:underline sm:text-lg"
    >
      {memory.data.title}
    </h3>
    {
      memory.data.date && memory.data.showDate && (
        <p class="mt-1 text-xs text-stone-500 sm:text-sm">
          <time datetime={memory.data.date.toISOString().slice(0, 10)}>
            {formatDate(memory.data.date, lang)}
          </time>
        </p>
      )
    }
  </a>
</article>

---
import { render, type CollectionEntry } from 'astro:content';
import { type Locale, useTranslations, formatDate } from '../i18n';

/**
 * Evenimentul de deschidere: data și locul urcă în supratitlu, ca într-un anunț
 * de program, iar titlul primește dimensiunea unui cap de articol. Restul
 * evenimentelor se listează ca rânduri de arhivă.
 */
interface Props {
  event: CollectionEntry<'evenimente'>;
  lang: Locale;
  headingLevel?: 'h2' | 'h3';
}

const { event, lang, headingLevel: Heading = 'h3' } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(event);
const iso = event.data.date.toISOString().slice(0, 10);
---

<article id={`eveniment-${event.data.translationKey}`}>
  <p class="eyebrow">
    <time datetime={iso}>{formatDate(event.data.date, lang)}</time>
    {event.data.location && <span class="mx-2 text-rule" aria-hidden="true">·</span>}
    {event.data.location}
  </p>

  <Heading class="mt-3 font-serif text-3xl font-bold leading-tight text-ink sm:text-4xl">
    {event.data.title}
  </Heading>

  <div class="prose-j mt-5 max-w-[62ch] text-ink">
    <Content />
  </div>

  {
    event.data.registrationLink && (
      <p class="mt-6">
        <a
          href={event.data.registrationLink}
          target="_blank"
          rel="noopener"
          class="font-sans text-[0.6875rem] font-semibold uppercase tracking-[0.14em] text-accent underline decoration-accent/40 underline-offset-4 hover:decoration-accent"
        >
          {t('activities.register')}
        </a>
      </p>
    )
  }
</article>

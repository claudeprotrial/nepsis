---
import { Image } from 'astro:assets';
import { type Locale, useTranslations, localePath } from '../i18n';
import ObfuscatedEmail from './ObfuscatedEmail.astro';
import SocialLinks from './SocialLinks.astro';
import sigla from '../assets/sigla-tus.png';

/** Subsolul e tot „lumina de zi”: fără roșu, fără rotunjiri, fără umbre. */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const legatura = 'text-cerneala underline decoration-linie underline-offset-4 transition-colors hover:decoration-cerneala';
---

<footer class="border-t border-linie bg-zi text-cerneala">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-[minmax(0,1.3fr)_1fr_1fr]">
    <div>
      <a href={localePath(lang, '/')} class="inline-block">
        <Image src={sigla} alt={t('site.name')} width={160} height={157} format="webp" loading="lazy" class="h-auto w-20" />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-umbra">{t('footer.tagline')}</p>
    </div>

    <div>
      <h2 class="font-sans text-sm font-medium">{t('footer.contact')}</h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><ObfuscatedEmail class={legatura} /></li>
        <li>
          <a href={localePath(lang, '/newsletter/')} class={legatura}>{t('contact.newsletterLink')}</a>
        </li>
      </ul>
    </div>

    <div>
      <h2 class="font-sans text-sm font-medium">{t('footer.social')}</h2>
      <SocialLinks showGroups={false} class="mt-2 -ml-2.5 gap-0.5" />
    </div>
  </div>

  <div class="border-t border-linie">
    <p class="mx-auto max-w-7xl px-4 py-5 text-xs text-umbra">© {year} Nepsis Elvetia. {t('footer.rights')}</p>
  </div>
</footer>

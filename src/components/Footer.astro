---
import { Image } from 'astro:assets';
import { type Locale, useTranslations, localePath } from '../i18n';
import ObfuscatedEmail from './ObfuscatedEmail.astro';
import SocialLinks from './SocialLinks.astro';
import logo from '../assets/logo-small.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<!--
  Fără margine sau chenar deasupra: schimbarea de culoare e singurul hotar de care
  e nevoie. O margine albă ar tăia o dungă de hârtie între banda roșie de invitație
  și footer, iar cele două benzi întunecate trebuie să se atingă.
-->
<footer class="bg-brand-950 text-stone-300">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-6 px-4 py-14 text-center">
    <a href={localePath(lang, '/')} class="flex flex-col items-center gap-4">
      <Image
        src={logo}
        alt=""
        width="160"
        height="160"
        format="webp"
        class="h-20 w-20 rounded-full border-2 border-white/20 object-cover shadow-md"
        loading="lazy"
      />
      <span class="font-serif text-2xl font-bold uppercase tracking-wide text-white">{t('site.name')}</span>
    </a>

    <p class="max-w-md text-sm leading-relaxed text-stone-400">{t('footer.tagline')}</p>

    <SocialLinks
      showGroups={false}
      class="justify-center gap-3 [&_a]:text-stone-400 [&_a:hover]:bg-brand-800 [&_a:hover]:text-white"
    />

    <p class="text-sm">
      <ObfuscatedEmail class="text-brand-200 underline decoration-brand-700 underline-offset-2 hover:text-white" />
      <span class="mx-2 text-stone-600" aria-hidden="true">·</span>
      <a href={localePath(lang, '/newsletter/')} class="underline decoration-brand-700 underline-offset-2 hover:text-white">
        {t('contact.newsletterLink')}
      </a>
    </p>
  </div>

  <div class="border-t border-brand-900">
    <p class="mx-auto max-w-6xl px-4 py-4 text-center text-xs text-stone-400">
      © {year} Nepsis Elvetia. {t('footer.rights')}
    </p>
  </div>
</footer>

---
import Emblema from './Emblema.astro';
import ObfuscatedEmail from './ObfuscatedEmail.astro';
import SocialLinks from './SocialLinks.astro';
import { type Locale, useTranslations, localePath } from '../i18n';

/**
 * Subsolul închide pagina în roșul cel mai adânc, cu sigla mare ton pe ton în
 * spate — semnătura, nu un al doilea meniu.
 */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const rubrici = [
  { href: '/evenimente/', label: t('nav.activities') },
  { href: '/amintiri/', label: t('nav.memories') },
  { href: '/ocrotitorul/', label: t('nav.patron') },
  { href: '/membri/', label: t('nav.members') },
  { href: '/psaltica/', label: t('nav.psaltica') },
  { href: '/devino-membru/', label: t('nav.join') },
];
---

<footer class="relative overflow-hidden bg-swiss-dark text-white">
  <!-- Sigla uriașă, abia vizibilă: ton pe ton, decorativă. -->
  <Emblema class="pointer-events-none absolute -right-10 -bottom-16 h-72 w-72 text-white/[0.06] sm:h-96 sm:w-96" />

  <div class="relative mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:grid-cols-2 lg:grid-cols-3 lg:gap-14">
    <div>
      <a href={localePath(lang, '/')} class="flex items-center gap-3">
        <Emblema class="h-9 w-9 text-white" />
        <span class="font-serif text-lg font-bold uppercase tracking-[0.1em]">{t('site.name')}</span>
      </a>
      <p class="mt-4 max-w-xs text-[0.9375rem] leading-relaxed text-white/70">{t('footer.about')}</p>
    </div>

    <nav aria-label={t('nav.menu')}>
      <p class="eyebrow text-white/60">{t('footer.sections')}</p>
      <ul class="mt-4 space-y-2.5">
        {
          rubrici.map((r) => (
            <li>
              <a
                href={localePath(lang, r.href)}
                class="font-serif text-[1.0625rem] text-white/90 underline decoration-white/25 underline-offset-4 transition-colors hover:decoration-white"
              >
                {r.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <p class="eyebrow text-white/60">{t('footer.contact')}</p>
      <p class="mt-4 text-[0.9375rem]">
        <ObfuscatedEmail class="text-white underline decoration-white/25 underline-offset-4 hover:decoration-white" />
      </p>
      <p class="mt-2.5 text-[0.9375rem]">
        <a
          href={localePath(lang, '/newsletter/')}
          class="text-white underline decoration-white/25 underline-offset-4 hover:decoration-white"
        >
          {t('contact.newsletterLink')}
        </a>
      </p>
      <SocialLinks showGroups={false} class="mt-5 gap-1 [&_a]:text-white/70 [&_a:hover]:text-white" />
    </div>
  </div>

  <div class="relative border-t border-white/15">
    <p class="mx-auto max-w-7xl px-4 py-4 text-center font-sans text-[0.6875rem] uppercase tracking-[0.1em] text-white/60">
      © {year} Nepsis Elveția — {t('footer.rights')}
    </p>
  </div>
</footer>

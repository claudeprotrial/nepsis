---
import { Image } from 'astro:assets';
import { type Locale, useTranslations, localePath, stripLocale } from '../i18n';
import LangSwitcher from './LangSwitcher.astro';
import logo from '../assets/logo-small.jpg';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = stripLocale(Astro.url.pathname);

const items = [
  { href: '/', label: t('nav.home') },
  { href: '/evenimente/', label: t('nav.activities') },
  { href: '/amintiri/', label: t('nav.memories') },
  { href: '/ocrotitorul/', label: t('nav.patron') },
  { href: '/membri/', label: t('nav.members') },
  { href: '/psaltica/', label: t('nav.psaltica') },
  { href: '/contact/', label: t('nav.contact') },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<header class="sticky top-0 z-40 border-b border-stone-200 bg-paper/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-2">
    <a href={localePath(lang, '/')} class="flex shrink-0 items-center gap-3">
      <Image
        src={logo}
        alt="Nepsis Elveția"
        width="88"
        height="88"
        format="webp"
        class="h-11 w-11 rounded-full border border-stone-200 object-cover"
      />
      <span class="whitespace-nowrap font-serif text-lg font-semibold tracking-tight text-brand-900">{t('site.name')}</span>
    </a>

    <nav class="hidden items-center gap-0.5 xl:flex" aria-label={t('nav.menu')}>
      {
        items.map((item) => (
          <a
            href={localePath(lang, item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap rounded-md px-2.5 py-2 text-sm font-medium transition-colors',
              isActive(item.href)
                ? 'bg-brand-100 text-brand-900'
                : 'text-stone-700 hover:bg-brand-50 hover:text-brand-900',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-3 xl:flex">
      <a
        href={localePath(lang, '/devino-membru/')}
        class="whitespace-nowrap rounded-lg bg-brand-800 px-3.5 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
      >
        {t('nav.join')}
      </a>
      <LangSwitcher lang={lang} />
    </div>

    <button
      id="meniu-buton"
      type="button"
      class="rounded-md border border-stone-300 p-2 text-stone-700 hover:bg-brand-50 xl:hidden"
      aria-expanded="false"
      aria-controls="meniu-mobil"
      aria-label={t('nav.openMenu')}
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="meniu-mobil" class="hidden border-t border-stone-200 px-4 pb-4 xl:hidden" aria-label={t('nav.menu')}>
    <ul class="flex flex-col py-2">
      {
        items.map((item) => (
          <li>
            <a
              href={localePath(lang, item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block rounded-md px-3 py-2.5 text-base font-medium',
                isActive(item.href)
                  ? 'bg-brand-100 text-brand-900'
                  : 'text-stone-700 hover:bg-brand-50 hover:text-brand-900',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={localePath(lang, '/devino-membru/')}
      class="mb-3 block rounded-lg bg-brand-800 px-3.5 py-2.5 text-center text-base font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
    >
      {t('nav.join')}
    </a>
    <div class="border-t border-stone-200 pt-3">
      <LangSwitcher lang={lang} />
    </div>
  </nav>
</header>

<script>
  const buton = document.getElementById('meniu-buton');
  const meniu = document.getElementById('meniu-mobil');
  buton?.addEventListener('click', () => {
    const deschis = !meniu?.classList.toggle('hidden');
    buton.setAttribute('aria-expanded', String(deschis));
  });
</script>

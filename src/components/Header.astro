---
import { Image } from 'astro:assets';
import { type Locale, useTranslations, localePath, stripLocale } from '../i18n';
import LangSwitcher from './LangSwitcher.astro';
import sigla from '../assets/sigla-tus.png';

/**
 * Antetul e „lumina de zi”: fără roșu. Sigla stă la proporțiile ei reale, pe fond
 * transparent — decupajul rotund de dinainte mutila un desen făcut de mână.
 */
interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = stripLocale(Astro.url.pathname);

const items = [
  { href: '/', label: t('nav.home') },
  { href: '/evenimente/', label: t('nav.activities') },
  { href: '/amintiri/', label: t('nav.memories') },
  { href: '/ocrotitorul/', label: t('nav.patron') },
  { href: '/echipa/', label: t('nav.members') },
  { href: '/psaltica/', label: t('nav.psaltica') },
  { href: '/contact/', label: t('nav.contact') },
];

/*
 * Lățimea de care are nevoie meniul orizontal diferă mult de la o limbă la alta:
 * etichetele germane („Byzantinischer Gesang”, „Veranstaltungen”) sunt mult mai
 * lungi. Un prag unic ori taie româna prea devreme, ori lasă germana să se reverse
 * peste selectorul de limbă, deci germana primește pragul următor. Clasele se scriu
 * întregi, nu compuse din bucăți, altfel Tailwind nu le-ar genera.
 * Dacă se adaugă rubrici în meniu, pragurile trebuie remăsurate.
 */
const navDesktop = lang === 'de' ? 'hidden items-center gap-5 2xl:flex' : 'hidden items-center gap-5 xl:flex';
const actiuniDesktop = lang === 'de' ? 'hidden items-center gap-5 2xl:flex' : 'hidden items-center gap-5 xl:flex';
const doarMobil = lang === 'de' ? '2xl:hidden' : 'xl:hidden';

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<header class="sticky top-0 z-40 border-b border-linie bg-zi/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
    <a href={localePath(lang, '/')} class="flex shrink-0 items-center gap-3">
      <Image src={sigla} alt="" width={58} height={57} format="webp" class="h-7 w-auto" />
      <span class="font-serif text-xl text-cerneala">{t('site.name')}</span>
    </a>

    <nav class={navDesktop} aria-label={t('nav.menu')}>
      {
        items.map((item) => (
          <a
            href={localePath(lang, item.href)}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'py-2 text-sm whitespace-nowrap underline-offset-[6px] transition-colors',
              isActive(item.href)
                ? 'text-cerneala underline decoration-cerneala'
                : 'text-umbra hover:text-cerneala',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class={actiuniDesktop}>
      <a
        href={localePath(lang, '/devino-membru/')}
        class="rounded-[3px] border border-cerneala px-3.5 py-2 text-sm font-medium whitespace-nowrap text-cerneala transition-colors hover:bg-cerneala hover:text-lumina"
      >
        {t('nav.join')}
      </a>
      <LangSwitcher lang={lang} />
    </div>

    <button
      id="meniu-buton"
      type="button"
      class:list={['p-2 text-cerneala', doarMobil]}
      aria-expanded="false"
      aria-controls="meniu-mobil"
      aria-label={t('nav.openMenu')}
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
  </div>

  <nav id="meniu-mobil" class:list={['hidden border-t border-linie px-4 pb-5', doarMobil]} aria-label={t('nav.menu')}>
    <ul class="flex flex-col py-2">
      {
        items.map((item) => (
          <li>
            <a
              href={localePath(lang, item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'block py-3 text-base underline-offset-[6px]',
                isActive(item.href) ? 'text-cerneala underline decoration-cerneala' : 'text-umbra',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href={localePath(lang, '/devino-membru/')}
      class="mb-4 block rounded-[3px] border border-cerneala px-4 py-3 text-center text-base font-medium text-cerneala"
    >
      {t('nav.join')}
    </a>
    <div class="border-t border-linie pt-4">
      <LangSwitcher lang={lang} />
    </div>
  </nav>
</header>

<script>
  const buton = document.getElementById('meniu-buton');
  const meniu = document.getElementById('meniu-mobil');
  buton?.addEventListener('click', () => {
    const deschis = !meniu?.classList.toggle('hidden');
    buton.setAttribute('aria-expanded', String(deschis));
  });
</script>

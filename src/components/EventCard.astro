---
import Foto from './Foto.astro';
import Emblema from './Emblema.astro';
import { type Locale, formatDate } from '../i18n';
import type { CollectionEntry } from 'astro:content';

/** Un eveniment trecut, în grilă: fotografie tratată în roșu, titlu, dată și loc. */
interface Props {
  event: CollectionEntry<'evenimente'>;
  lang: Locale;
}

const { event, lang } = Astro.props;
---

<article>
  {
    event.data.image ? (
      <Foto src={event.data.image} alt={event.data.imageAlt ?? ''} class="aspect-[4/3]" />
    ) : (
      <div class="flex aspect-[4/3] items-center justify-center bg-swiss/10">
        <Emblema class="h-14 w-14 text-swiss/25" />
      </div>
    )
  }
  <p class="mt-3 font-sans text-xs tracking-[0.06em] text-muted">
    <time datetime={event.data.date.toISOString().slice(0, 10)}>
      {formatDate(event.data.date, lang)}
    </time>
    {event.data.location && <span class="mx-1.5 text-rule">·</span>}
    {event.data.location}
  </p>
  <h3 class="mt-1 font-serif text-lg font-bold leading-snug text-ink sm:text-xl">
    {event.data.title}
  </h3>
</article>

---
import Emblema from './Emblema.astro';

/**
 * Antetul paginilor interioare: aceeași bandă roșie ca pe prima pagină, ca
 * identitatea să nu se piardă când treci de la o rubrică la alta. Sigla stă
 * mare, ton pe ton, în dreapta.
 */
interface Props {
  title: string;
  eyebrow?: string;
  intro?: string;
}

const { title, eyebrow, intro } = Astro.props;
---

<section class="relative overflow-hidden bg-swiss text-white">
  <Emblema
    class="pointer-events-none absolute -top-10 -right-16 h-64 w-64 text-swiss-deep sm:h-80 sm:w-80 lg:-right-6 lg:h-96 lg:w-96"
  />
  <div class="relative mx-auto max-w-7xl px-4 py-12 sm:py-16">
    {eyebrow && <p class="eyebrow text-white/75">{eyebrow}</p>}
    <h1
      class:list={[
        'font-serif text-[2.25rem] font-bold leading-tight sm:text-5xl lg:text-6xl',
        eyebrow && 'mt-3',
      ]}
    >
      {title}
    </h1>
    {intro && <p class="mt-5 max-w-[56ch] text-base leading-relaxed text-white/85 sm:text-lg">{intro}</p>}
    <slot />
  </div>
</section>
